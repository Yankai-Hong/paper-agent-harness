# Copy to .env. Do not commit real keys. Only ask/chat and run_dialogues.py call API.
API_KEY=
API_BASE_URL=https://api.deepseek.com
# Verify availability in your provider console; model aliases can change.
MODEL_ID=deepseek-flash
API_JSON_MODE=true
API_MAX_TOKENS=2048
API_TIMEOUT=120
# Per reasoner instance, including NLU/Reflect/Generate and retries.
API_MAX_CALLS=100
API_MAX_INPUT_CHARS=80000
# DeepSeek supports this; leave unset for gateways that do not.
API_THINKING=disabled
# Generic Chat Completions endpoints are supported. See docs/api.md for Go limits.
# Go base URL (only if your use is permitted by provider):
# API_BASE_URL=https://opencode.ai/inference/go/openai/v1
# MODEL_ID=<chat-completions-compatible-model-from-console>
# API_JSON_MODE=false

# SQLite local mode is the default. Explicit three_layer enables Redis and Chroma projections.
MEMORY_BACKEND=sqlite_local
REDIS_URL=redis://localhost:6379/0
MEMORY_REDIS_NAMESPACE=paper-agent:working:v1
MEMORY_WORKING_TTL=86400
MEMORY_ALLOW_FALLBACK=true
# Defaults to <memory_dir>/chroma when unset. SQLite: <memory_dir>/memory.sqlite3.
# MEMORY_CHROMA_PATH=runs/memory/chroma
MEMORY_CHROMA_COLLECTION=paper_agent_episodes_v1
# Minimum cosine similarity for normalized episodic vectors (0..1).
MEMORY_MIN_SIMILARITY=0.35
# Enable with MEMORY_BACKEND=three_layer and the existing local BGE encoder.
# These are local namespaces, not authenticated identities. Sharing is opt-in.
MEMORY_LOCAL_USER=local
# MEMORY_PROJECT=my-project
MEMORY_SHARE_PROJECT=false

# Optional complex retrieval planning and process-local provider circuit breaker.
PAPER_DECOMPOSITION=false
API_CIRCUIT_ENABLED=false
API_CIRCUIT_THRESHOLD=3
API_CIRCUIT_COOLDOWN=30
PAPER_TURN_SECONDS=180
PAPER_TURN_MODEL_REQUESTS=8
PAPER_TURN_SUBQUERIES=6
PAPER_TURN_CANDIDATES=90
PAPER_TURN_RERANK=60

# Opt-in metadata-only telemetry; never put keys into this example file.
PAPER_TELEMETRY_ENABLED=false
PAPER_TELEMETRY_SAMPLE_RATE=1
# PAPER_TELEMETRY_DEDUP_DIR=.cache/paper-agent-telemetry
# LANGFUSE_BASE_URL=https://your-instance.example
# LANGFUSE_PUBLIC_KEY=...
# LANGFUSE_SECRET_KEY=...

      "output": {
        "claims": [
          {
            "key": "twitter_better_language_inventory",
            "text": "Twitter data makes better predictions about the inventory of languages used in each country.",
            "citations": [
              {
                "paper_id": "2004.00809",
                "chunk_id": "c-204aa49abd2af324ac170d44"
              }
            ]
          },
          {
            "key": "twitter_fewer_missing_languages",
            "text": "Given available ground-truth language-use data, the corpora do not represent all languages produced by local populations in some countries, but Twitter has fewer missing languages than the web-crawled corpus.",
            "citations": [
              {
                "paper_id": "2004.00809",
                "chunk_id": "c-9887004ca215701b79e8e570"
              }
            ]
          },
          {
            "key": "twitter_more_false_positives",
            "text": "While false positives are in general very uncommon, there are more false positives in Twitter data than in web-crawled data.",
            "citations": [
              {
                "paper_id": "2004.00809",
                "chunk_id": "c-9887004ca215701b79e8e570"
              }
            ]
          },
          {
            "key": "twitter_better_north_america_oceania",
            "text": "The two corpora agree on predicted languages in Europe, parts of Africa with ground-truth data, and South America, but Twitter provides a better representation of North America and Oceania.",
            "citations": [
              {
                "paper_id": "2004.00809",
                "chunk_id": "c-01b9a363a68a29a0e9af4ff8"
              }
            ]
          },
          {
            "key": "gdp_bias_explanation",
            "text": "Twitter data matches populations better when population numbers are weighted by GDP and worse when weighted by internet-usage statistics, which the authors interpret as implying Twitter represents more wealthy populations than general web-crawled data.",
            "citations": [
              {
                "paper_id": "2004.00809",
                "chunk_id": "c-9887004ca215701b79e8e570"
              }
            ]
          },
          {
            "key": "urban_bias_alternative",
            "text": "An alternate interpretation offered is that the Twitter collection is based on urban areas, which tend to have wealthier populations.",
            "citations": [
              {
                "paper_id": "2004.00809",
                "chunk_id": "c-9887004ca215701b79e8e570"
              }
            ]
          },
          {
            "key": "english_spanish_defaults",
            "text": "Both English and Spanish are very common on Twitter, so any country predominantly using these two languages will have a good representation by default.",
            "citations": [
              {
                "paper_id": "2004.00809",
                "chunk_id": "c-01b9a363a68a29a0e9af4ff8"
              }
            ]
          },
          {
            "key": "collection_no_language_bias",
            "text": "Twitter and web data were systematically collected from locations around the world without language-specific searches that would bias the collection.",
            "citations": [
              {
                "paper_id": "2004.00809",
                "chunk_id": "c-9887004ca215701b79e8e570"
              }
            ]
          }

                "chunk_id": "c-316cc9c43fddce56987ca066"
              }
            ]
          },
          {
            "key": "sesame_named",
            "text": "SESAME是使用该提出方法生成的葡萄牙语NER大规模数据集，其全称为Silver-Standard Named Entity Recognition dataset。",

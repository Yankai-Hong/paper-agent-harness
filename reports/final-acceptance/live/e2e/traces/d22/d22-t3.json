        "claims": [
          {
            "key": "sesame_automatic_generation",
            "text": "The SESAME paper (Building a Massive Corpus for NER) proposes a method to automatically generate labeled datasets for NER from public data sources (DBpedia and Wikipedia); the resulting SESAME dataset is described as a massive, weakly-supervised silver-standard corpus constructed without human supervision, with its methodology stated to automatically generate the dataset.",
            "citations": [
              {
                "paper_id": "1908.05758",
                "chunk_id": "c-04f1fdda9b30597feeeefad5"
              },
              {
                "paper_id": "1908.05758",
                "chunk_id": "c-002d0659794b118dc27438e1"
              }
            ]
          },
          {
            "key": "croatian_no_dataset",
            "text": "The Croatian MT paper (A Lost Croatian Cybernetic Machine Translation Program) describes historical research on machine translation by Bulcsu Laszlo's group in Yugoslavia in the 1950s and early 1960s; the supplied evidence does not describe any dataset generation for that paper, so the question of a completely automatically generated dataset does not apply in the same sense.",
            "citations": [
              {
                "paper_id": "1908.08917",
                "chunk_id": "c-abb668d90226308be8e33e5f"
              }
            ]
          },
          {
            "key": "croatian_us_ussr_context",
            "text": "The Croatian paper explicitly connects its subject to the beginnings of machine translation in the USA and USSR, motivated by the Cold War and intelligence needs of the period.",
            "citations": [
              {
                "paper_id": "1908.08917",
                "chunk_id": "c-abb668d90226308be8e33e5f"
              }
            ]
          },
          {
            "key": "croatian_ussr_comparison",
            "text": "The Croatian paper surveys four major USSR machine translation approaches in the late 1950s, noting that the information-theoretic (cybernetic) approach of Lyapunov, Kulagina and Dobrushin was the main role model for the Croatian efforts from 1957 onwards.",
            "citations": [
              {
                "paper_id": "1908.08917",
                "chunk_id": "c-bd28c872a0ec084173d1c794"
              }
            ]
          },
          {
            "key": "croatian_distinct_approach",
            "text": "The Croatian paper presents the Croatian group's approach as different from the usual logical approaches of the period, advocating cybernetic methods later adopted as canon by mainstream AI.",
            "citations": [
              {
                "paper_id": "1908.08917",
                "chunk_id": "c-abb668d90226308be8e33e5f"
              }
            ]
          },
          {
            "key": "sesame_no_us_ussr_comparison",
            "text": "The SESAME paper does not, in the supplied evidence, make any comparison to US or USSR research; it instead positions itself relative to prior automatic Wikipedia-based dataset creation work and distant learning approaches.",
            "citations": [
              {
                "paper_id": "1908.05758",

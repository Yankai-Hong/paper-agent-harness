          "no_computer_alignment": {
            "text": "论文指出，该研究组没有可用来构建原型的计算机，并且低估了确定句子对齐的复杂性；论文还称，对齐模块直到 1990 年代末才由 Tillmann 与 Ney 等人在统计模型中使用，而句子对齐要到深度学习（控制论模型）时代才被实现（BIBREF24–BIBREF27）。",
            "evidence_ids": [
              "c-5baec571c9a5cce8d063341c"
            ],
            "turn_id": "d23-t2"
          },
          "data_preparation_tasks": {
            "text": "论文记载，Finka 和 Laszlo 提出原型开发前的三项数据准备工作（BIBREF10）：编排按词尾到词首排序的词典，以便建立词干与词元化模块；制作词频表，以聚焦数千个高频词；以及建立以“意义”为键、以同义词为值的分类词库。",
            "evidence_ids": [
              "c-495de085a178c536aca1b688"
            ],
            "turn_id": "d23-t2"
          },
          "croatia_compare_us_ussr": {
            "text": "该论文将克罗地亚小组的工作放在美国与苏联机器翻译起步的语境中考察，这些研究受冷战动机和当时情报需求驱动。",
            "evidence_ids": [
              "c-abb668d90226308be8e33e5f"
            ],
            "turn_id": "d23-t3"
          },
          "croatia_method_contrast": {
            "text": "论文指出克罗地亚小组主张的控制论机器翻译方法不同于当时通常的逻辑方法，而这类控制论方法直到数十年后才被主流AI界奉为准则。",
            "evidence_ids": [
              "c-abb668d90226308be8e33e5f"
            ],
            "turn_id": "d23-t3"
          },
          "ussr_four_approaches": {
            "text": "论文概述了苏联1950年代后期的四种主要机器翻译路线：苏联科学院精确机械与计算技术研究所的实验性方法、Steklov数学研究所Reformatsky团队以逻辑为主的方法、Lyapunov/Kulagina/Dobrushin以信息论为主（当时被视为控制论）的方法，以及列宁格勒大学Andreev团队使用中介语的方法。",
            "evidence_ids": [
              "c-bd28c872a0ec084173d1c794"
            ],
            "turn_id": "d23-t3"
          },
          "croatia_role_model": {
            "text": "论文称Lyapunov、Kulagina、Dobrushin的信息论方法自1957年起成为克罗地亚工作的主要榜样。",
            "evidence_ids": [
              "c-bd28c872a0ec084173d1c794"
            ],
            "turn_id": "d23-t3"
          },
          "croatia_no_dataset": {
            "text": "所给证据未提及克罗地亚小组训练或评估所用的数据集；证据反而指出该小组没有可用计算机来构建原型。",
            "evidence_ids": [
              "c-5baec571c9a5cce8d063341c"
            ],
            "turn_id": "d23-t3"
          },
          "hungarian_dataset": {
            "text": "Hungarian Layer论文在“Quora Question Pairs”公开基准数据集上进行实验，任务是释义识别（paraphrase identification）。",
            "evidence_ids": [
              "c-70876748d6ad7c5c4f480427"
            ],
            "turn_id": "d23-t3"
          },
          "hungarian_no_us_ussr": {
            "text": "所给证据未显示Hungarian Layer论文将其研究与当时美国或苏联的研究进行比较；其对比对象是释义识别与动态可微计算图的相关工作。",
            "evidence_ids": [
              "c-70876748d6ad7c5c4f480427"
            ],
            "turn_id": "d23-t3"
          },
          "not_comparable": {
            "text": "两篇论文在时代、任务（1950-60年代克罗地亚机器翻译历史 vs. 现代释义识别神经网络）和证据性质上不同，因此对“与美国/苏联研究的比较”和“训练数据集”这两个问题的回答不具备直接可比性。",
            "evidence_ids": [
              "c-abb668d90226308be8e33e5f",
              "c-70876748d6ad7c5c4f480427"
            ],
            "turn_id": "d23-t3"
          }
        },

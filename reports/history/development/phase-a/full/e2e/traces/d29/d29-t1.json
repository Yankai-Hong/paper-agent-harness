              "c-352921953f298264d3e703f1"
            ],
            "turn_id": "d29-t1"
          },
          "profiling_features": {
            "text": "调查指出，许多研究者迄今仅依赖基于文本的特征进行滥用检测，但近期工作表明用户的个人与社区画像特征能显著提升最先进水平。",
            "evidence_ids": [
              "c-352921953f298264d3e703f1"
            ],
            "turn_id": "d29-t1"
          },
          "metaphors_in_abuse": {
            "text": "调查提到，Mishra 发现隐喻在滥用样本中比在非滥用样本中更频繁。",
            "evidence_ids": [
              "c-482db66d96fa77c449b5baed"
            ],
            "turn_id": "d29-t1"
          },
          "sarcasm_surface_insufficient": {
            "text": "调查报告称，Nobata 等人（以及 van Aken 等人）指出讽刺评论难以被滥用检测方法处理，因为表层特征不够，通常还需要关于用户语境或背景的知识。",
            "evidence_ids": [

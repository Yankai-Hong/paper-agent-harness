            ],
            "turn_id": "mem-d03-t7"
          },
          "classifier_output": {
            "text": "分类器基于正确回答的问题和一个阈值计算标签，目前能把 claim 分类为“SUPPORTS”和“MANUAL_REVIEW”。",
            "evidence_ids": [

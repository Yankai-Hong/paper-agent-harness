            ],
            "turn_id": "mem-d07-t8"
          },
          "feature_type_semantic": {
            "text": "语义（Sem）特征基于瑞典语词汇语义资源SALDO，使用每个token的平均义项数以及每个名词的平均名词义项数。",
            "evidence_ids": [

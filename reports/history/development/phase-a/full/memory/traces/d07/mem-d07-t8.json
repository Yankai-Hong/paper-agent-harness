            "turn_id": "mem-d07-t7"
          },
          "unanswerable_full_table": {
            "text": "不能依据所给证据完整回答特征清单：原文特征描述引用了表 TABREF6，但该表的完整编号与逐项特征值不在提供的证据片段中，因此无法逐条列出全部特征及其确切定义。",
            "evidence_ids": [
              "c-95d315be5888ab22f7efbd62",
              "c-56c4d684e5cbe3b1ead9168e"
            ],
            "turn_id": "mem-d07-t7"
          },
          "unanswerable_independent_validation": {
            "text": "不能依据所给证据回答这些特征在其他语言或独立数据集上的有效性；原文仅在结论中提出未来探索基于瑞典语词汇语义资源的新特征，并未在提供的证据中报告此类验证。",
            "evidence_ids": [
              "c-f16421f0ee652e6ad37ac288"
            ],
            "turn_id": "mem-d07-t7"
          },
          "total_feature_set": {
            "text": "该论文使用了一个包含61个特征的完整特征集（列于Table 6），文档级实验中使用该完整特征集的机器学习模型；句子级和文档级分析的特征均对每个句子抽取，文档级实验中取全文所有句子的平均值以保证可比性。",
            "evidence_ids": [
              "c-47c5ecbffa06b11f999ffb18"
            ],
            "turn_id": "mem-d07-t8"
          },
          "feature_type_morph": {
            "text": "形态学（Morph）特征包括：各词类（名词、动词、形容词、副词）的变化度（某类别比例与词汇token比例之比）及所有词汇类别的IncSc，加上标点、小品词、从属连词和并列连词的IncSc（#34、#51）。",
            "evidence_ids": [
              "c-56c4d684e5cbe3b1ead9168e"
            ],
            "turn_id": "mem-d07-t8"
          },
          "feature_type_morph_inflection": {
            "text": "借鉴L2教学材料的洞见，论文加入了细粒度屈折信息特征，如中性性别名词的IncSc以及不同动词形式占全部动词的比例（#52–#56）。",
            "evidence_ids": [

            ],
            "turn_id": "mem-d07-t8"
          },
          "feature_type_morph_lexical_density": {
            "text": "论文用双对数和平方根类符-形符比（TTR）替代简单TTR，并加入名词比例、代词与介词之比和两个词汇密度特征：词汇词与非词汇类别之比（#48）和词汇词与全部token之比（#49）。",
            "evidence_ids": [

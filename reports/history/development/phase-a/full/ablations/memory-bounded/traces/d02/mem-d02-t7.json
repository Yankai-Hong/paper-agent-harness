            "turn_id": "mem-d02-t6"
          },
          "abstract_correlation_values": {
            "text": "摘要中给出两套数据与真实人口的相关性为 r=0.60（社交媒体）和 r=0.49（网络抓取），且两套数据代表非常不同的人群。",
            "evidence_ids": [
              "c-204aa49abd2af324ac170d44"
            ],
            "turn_id": "mem-d02-t6"
          },
          "fewer_missing_languages_twitter": {
            "text": "在给定现有真实语言使用数据的情况下，存在一些国家其全部语言未被语料库覆盖；这种情况下 Twitter 缺失的语言更少。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570"
            ],
            "turn_id": "mem-d02-t6"
          },
          "more_false_positives_twitter": {
            "text": "总体上假阳性很少，但 Twitter 数据中的假阳性更多；这意味着仅依赖 Twitter 会显示这些国家存在更多样的语言使用人群。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570",
              "c-01b9a363a68a29a0e9af4ff8"
            ],
            "turn_id": "mem-d02-t6"
          },
          "regional_better_representation": {
            "text": "两套语料库在欧洲、有真实数据的部分非洲地区以及南美洲对语言的预测一致，但 Twitter 对北美和大洋洲的表示更好。",
            "evidence_ids": [
              "c-01b9a363a68a29a0e9af4ff8"
            ],
            "turn_id": "mem-d02-t6"
          },
          "few_languages_caveat": {
            "text": "许多国家只有少数几种语言，因此某国的高真阳性率可能只反映一两种语言；英语和西班牙语在 Twitter 上非常常见，因此以这两种语言为主的国家默认就会有较好表示。",
            "evidence_ids": [
              "c-01b9a363a68a29a0e9af4ff8"
            ],
            "turn_id": "mem-d02-t6"
          },
          "sampling_method": {
            "text": "Twitter 数据通过空间搜索收集 1 万个城市半径 50 公里内的推文，避免使用语言特定关键词或话题标签造成选择偏差；时间范围为 2017 年 5 月至 2019 年初。",
            "evidence_ids": [
              "c-227fd89576f8c0e3eb0ce352"
            ],
            "turn_id": "mem-d02-t6"
          },
          "gps_bias_caveat": {
            "text": "Twitter 数据集依赖地理定位推文，但并非所有用户都有 GPS 设备；预期人均 GDP 较低的国家地理定位推文比例更低、推文总量也更少。",
            "evidence_ids": [
              "c-227fd89576f8c0e3eb0ce352"
            ],
            "turn_id": "mem-d02-t6"
          },
          "gdp_internet_weighting": {
            "text": "Twitter 数据在以 GDP 加权人口时匹配更好，在以互联网使用统计加权时匹配更差，暗示 Twitter 平台代表的是比一般网络抓取数据更富裕的人群；另一种解释是 Twitter 收集基于城市地区。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570"
            ],
            "turn_id": "mem-d02-t6"
          },
          "unanswered_false_positive_sources": {
            "text": "原文指出需要更多研究来区分移民、旅游和商业作为数字数据集中假阳性语言出现的替代来源。",
            "evidence_ids": [
              "c-01b9a363a68a29a0e9af4ff8"
            ],
            "turn_id": "mem-d02-t6"
          },
          "unanswered_rural_bias": {
            "text": "原文将“以农村为中心的收集程序是否会出现同样的偏差”列为次要问题；现有证据未直接回答该问题。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570"
            ],
            "turn_id": "mem-d02-t6"
          },
          "not_population_ranking_focus": {
            "text": "论文的目标是测量这些数据集在何处、以何种方式被偏斜，作为评估和改进未来数据收集方法的手段，而非在此时判断语料库表示在特定地点是否偏斜或不准确。",
            "evidence_ids": [
              "c-9112346152089bf519490033"
            ],
            "turn_id": "mem-d02-t6"
          },
          "answerable_core_conclusion": {
            "text": "摘要明确指出：Twitter 数据能对国家所用语言清单做出更好的预测（“Twitter data makes better predictions about the inventory of languages used in each country”）。",
            "evidence_ids": [
              "c-204aa49abd2af324ac170d44"
            ],
            "turn_id": "mem-d02-t7"
          },
          "answerable_mechanism_missing_languages": {
            "text": "讨论部分给出支持该结论的机制性证据：在存在基准语言使用数据的国家中，有些国家数字文本未覆盖人口使用的全部语言，即普查中的部分语言在数字文本中缺失；而在这种情况下，Twitter 所缺失的语言更少。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570"
            ],
            "turn_id": "mem-d02-t7"
          },
          "answerable_regional_pattern": {
            "text": "原文指出，在预测各国所用语言方面，两个语料库在欧洲、有基准数据的非洲部分地区以及南美洲大体一致，但 Twitter 对北美和大洋洲的代表性更好。",
            "evidence_ids": [
              "c-01b9a363a68a29a0e9af4ff8"
            ],
            "turn_id": "mem-d02-t7"
          },
          "not_answerable_no_per_country_metrics": {
            "text": "所给证据没有提供按国家逐一比较 Twitter 与网络抓取数据在语言清单预测上的具体指标（如各国准确率、召回率或 F 值），因此无法回答“哪些具体国家上 Twitter 更优、优多少”。",
            "evidence_ids": [
              "c-01b9a363a68a29a0e9af4ff8"
            ],
            "turn_id": "mem-d02-t7"
          },
          "not_answerable_false_positive_caveat": {
            "text": "该结论并非无条件成立：讨论部分指出 Twitter 数据的假阳性（语料显示某语言在某国常用但普查未显示）虽然不多，但比网络抓取数据更多；因此不能把“Twitter 预测更优”理解为在所有指标上都更优。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570"
            ],
            "turn_id": "mem-d02-t7"
          },
          "not_answerable_ground_truth_limits": {
            "text": "证据无法回答 Twitter 优势是否在所有国家都成立，因为原文限定该比较以“现有基准语言使用数据”为前提，并指出并非所有普查语言都出现在数字文本中。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570"
            ],
            "turn_id": "mem-d02-t7"
          },
          "not_answerable_collection_confound": {
            "text": "证据表明 Twitter 语料依赖地理定位推文，而并非所有用户都有支持 GPS 的设备；原文推测人均 GDP 较低的国家地理定位推文比例可能更低，但未量化该偏差对国家语言清单预测优势的影响。",
            "evidence_ids": [
              "c-227fd89576f8c0e3eb0ce352"
            ],
            "turn_id": "mem-d02-t7"
          }
        },

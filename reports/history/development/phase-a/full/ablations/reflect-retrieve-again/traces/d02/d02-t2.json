        "facts": {
          "twitter_better_represented_regions": {
            "text": "The authors observe that Twitter provides a better representation of North America and Oceania for the languages used in each country.",
            "evidence_ids": [
              "c-01b9a363a68a29a0e9af4ff8"
            ],
            "turn_id": "d02-t1"
          },
          "twitter_fewer_missing_languages": {
            "text": "The authors state that, where corpora do not represent all the languages produced by local populations, Twitter has fewer missing languages than the web-crawled corpus.",
            "evidence_ids": [

            "turn_id": "d02-t1"
          },
          "wealthy_population_hypothesis": {
            "text": "The authors hypothesize that Twitter data matches populations better when weighted by GDP and worse when weighted by internet-usage statistics, which they say implies that Twitter as a platform represents more wealthy populations than general web-crawled data.",
            "evidence_ids": [

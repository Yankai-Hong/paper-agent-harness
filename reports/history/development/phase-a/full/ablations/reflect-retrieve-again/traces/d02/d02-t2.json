            ],
            "turn_id": "d02-t1"
          },
          "twitter_more_false_positives": {
            "text": "The authors note that while false positives are uncommon, there are more false positives in Twitter data, and that relying on Twitter alone would indicate more diverse language-speaking populations in certain countries.",

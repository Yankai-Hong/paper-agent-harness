              "c-c1a01afddd733ef65ed6d199"
            ],
            "turn_id": "e8a1e4325ab64ad28243d7f923aa6ea9"
          },
          "paper_1806_motivation": {
            "text": "1806.09652 关注非英语语言资源稀缺的问题，通过从互联网上可用的多语言文章中自动抽取平行句对来缓解该问题。",
            "evidence_ids": [
              "c-1dd6dc3c2f7d9eb29dc26d9f"
            ],
            "turn_id": "e8a1e4325ab64ad28243d7f923aa6ea9"
          },
          "paper_1806_method": {
            "text": "1806.09652 使用端到端的 Siamese 双向循环神经网络从 Wikipedia 的可比多语言文章中生成平行句，并显示所采集数据提升了英语–印地语和英语–泰米尔语低资源语言对上的 NMT 与短语-based SMT 系统 BLEU 分数。",
            "evidence_ids": [
              "c-1dd6dc3c2f7d9eb29dc26d9f"
            ],
            "turn_id": "e8a1e4325ab64ad28243d7f923aa6ea9"
          },
          "paper_1806_nmt_model": {
            "text": "1806.09652 训练神经机器翻译模型时使用 OpenNMT 的 TensorFlow 实现，并采用基于注意力的 transformer 架构；其 NMT 模型在 en–ta 和 en–hi 两个语言对上的 BLEU 分数均高于 SMT 模型。",
            "evidence_ids": [
              "c-0377bffbf88cf9ead25b03ff"
            ],
            "turn_id": "e8a1e4325ab64ad28243d7f923aa6ea9"
          },
          "comparability_models": {
            "text": "就“使用何种 NMT 模型”而言，两篇论文不可直接比较：1612.02695 使用的是基于注意力的 Listen, Attend and Spell seq2seq 语音识别模型而非翻译模型，而 1806.09652 使用 OpenNMT 的基于注意力的 transformer NMT 模型。",
            "evidence_ids": [
              "c-765ec796280535cd105fabf4",
              "c-0377bffbf88cf9ead25b03ff"
            ],
            "turn_id": "e8a1e4325ab64ad28243d7f923aa6ea9"
          },
          "comparability_shortcomings": {
            "text": "就“针对 seq2seq 缺陷的解决方案”而言，两篇论文关注的问题不同，因而不具可比性：1612.02695 针对 seq2seq 的过度自信与不完整转写，1806.09652 针对的是低资源语言下平行语料稀缺问题并通过数据采集加以解决。",
            "evidence_ids": [
              "c-c1a01afddd733ef65ed6d199",
              "c-1dd6dc3c2f7d9eb29dc26d9f"
            ],
            "turn_id": "e8a1e4325ab64ad28243d7f923aa6ea9"
          },
          "comparability_overall": {
            "text": "总体上，所给证据中 1612.02695 是语音识别领域的 seq2seq 分析，而 1806.09652 是低资源 NMT 的数据采集研究，二者任务、模型与针对的问题均不同，因此在此对比问题上不具有直接可比性。",
            "evidence_ids": [
              "c-c1a01afddd733ef65ed6d199",
              "c-1dd6dc3c2f7d9eb29dc26d9f"
            ],
            "turn_id": "e8a1e4325ab64ad28243d7f923aa6ea9"
          }
        },

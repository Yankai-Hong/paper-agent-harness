              "c-d56cdc01d43cd2975b96cb5f"
            ],
            "turn_id": "mem-d01-t4"
          },
          "method_template": {
            "text": "研究在12种性别中性语言（如匈牙利语、中文、约鲁巴语等）中构造“He/She is an Engineer”这类句子，用 Google Translate API 译为英语，并统计译文中女性、男性和性别中性代词的频率。",
            "evidence_ids": [
              "c-0ff7525d7bb39cc1411d378f"
            ],
            "turn_id": "mem-d01-t4"
          },
          "result_male_default": {
            "text": "Google Translate 表现出强烈的男性默认倾向，尤其是在与性别分布不平衡相关的领域（如 STEM 职业）。",
            "evidence_ids": [
              "c-0ff7525d7bb39cc1411d378f"
            ],
            "turn_id": "mem-d01-t4"
          },
          "result_vs_bls": {
            "text": "将这些统计结果与 BLS 各职业女性参与频率的数据对照，显示 Google Translate 未能再现现实世界中女性工作者的分布。",
            "evidence_ids": [
              "c-0ff7525d7bb39cc1411d378f"
            ],
            "turn_id": "mem-d01-t4"
          },
          "result_beyond_demographics": {
            "text": "论文提供实验证据表明，即使原则上不预期 50:50 的代词性别分布，Google Translate 产生男性默认的频率也远高于仅凭人口统计数据所能预期的水平。",
            "evidence_ids": [
              "c-0ff7525d7bb39cc1411d378f"
            ],
            "turn_id": "mem-d01-t4"
          },
          "stereotype_examples": {
            "text": "结果显示与刻板性别角色假设一致：nurse 和 baker 被译为女性代词，而 engineer 和 CEO 被译为男性代词。",
            "evidence_ids": [
              "c-10f671efdbe25a3af88930ca"
            ],
            "turn_id": "mem-d01-t4"
          },
          "time_snapshot": {
            "text": "所有实验分析的是该工具在 2018 年 8 月实施时的“快照”，当时 Google Translate 对每个输入词只提供一个官方译文。",
            "evidence_ids": [
              "c-a16ba09a7bc25650191fb8b9"
            ],
            "turn_id": "mem-d01-t4"
          },
          "policy_change": {
            "text": "2018 年 12 月 6 日 Google 政策改变，新增同时给出阴性与阳性官方译文的功能；论文称其公司声明承认模型会复制已存在的性别偏见，例如对“strong”“doctor”偏向男性、对“nurse”“beautiful”偏向女性。",
            "evidence_ids": [
              "c-a16ba09a7bc25650191fb8b9"
            ],
            "turn_id": "mem-d01-t4"
          },
          "can_answer_data_source": {
            "text": "论文使用来自美国劳工统计局（U.S. Bureau of Labor Statistics, BLS）的职业岗位列表来构建“他/她是一名工程师”这类句子，并涵盖匈牙利语、中文、约鲁巴语等12种性别中性语言。",
            "evidence_ids": [
              "c-0ff7525d7bb39cc1411d378f"
            ],
            "turn_id": "mem-d01-t5"
          },
          "can_answer_real_distribution": {
            "text": "作者将Google Translate输出中女性代词频率与BLS报告中各职业女性从业比例进行对比，发现Google Translate未能再现现实世界中女性工作者的分布。",
            "evidence_ids": [
              "c-0ff7525d7bb39cc1411d378f"
            ],
            "turn_id": "mem-d01-t5"
          },
          "can_answer_12quantile": {
            "text": "美国劳工统计局数据包含各职业类别女性参与比例，也可获得每个具体职业的数据，作者据此计算每个12分位上的女性参与频率，并与翻译中女性代词频率的分位直方图并排比较。",
            "evidence_ids": [
              "c-6d84e20bfa1a0d5f93e73fb6"
            ],
            "turn_id": "mem-d01-t5"
          },
          "can_answer_distribution_shape": {
            "text": "翻译输出中女性代词分布呈反向分布、集中在第一个12分位，而BLS数据显示女性参与率在第四个12分位达到峰值并在之后保持显著。",
            "evidence_ids": [
              "c-6d84e20bfa1a0d5f93e73fb6"
            ],
            "turn_id": "mem-d01-t5"
          },
          "can_answer_ttest": {
            "text": "作者对“女性参与频率不显著高于同一岗位Google Translate女性代词频率”的原假设进行单侧t检验，p值远低于置信水平，从而拒绝原假设，结论是Google Translate的女性翻译频率低估了美国岗位中的女性参与频率。",
            "evidence_ids": [
              "c-524c4c9c6f083273886d5971"
            ],
            "turn_id": "mem-d01-t5"
          },
          "can_answer_average_comparison": {
            "text": "在所有职业和语言上平均，翻译句子使用女性代词的比例低于BLS报告中所有职业女性工作者参与频率的平均值，且翻译结果的方差也更低。",
            "evidence_ids": [
              "c-524c4c9c6f083273886d5971"
            ],
            "turn_id": "mem-d01-t5"
          },
          "cannot_answer_other_countries": {
            "text": "所给证据只涉及美国BLS数据用于对比女性工作者现实分布，未提供使用其他国家数据考察该问题的证据。",
            "evidence_ids": [
              "c-0ff7525d7bb39cc1411d378f",
              "c-6d84e20bfa1a0d5f93e73fb6"
            ],
            "turn_id": "mem-d01-t5"
          },
          "cannot_answer_actual_numbers": {
            "text": "证据中的具体数值被占位符替代（如INLINEFORM0、INLINEFORM1），因此无法从所给证据给出翻译女性代词频率、BLS女性参与率、方差和p值的具体数字。",
            "evidence_ids": [
              "c-524c4c9c6f083273886d5971"
            ],
            "turn_id": "mem-d01-t5"
          },
          "cannot_answer_per_language_country": {
            "text": "证据说明了使用12种性别中性语言构建句子，但未说明这些语言所在国家/地区的女性工作者分布，也未按语言所在国家/地区分别与现实分布对比。",
            "evidence_ids": [
              "c-0ff7525d7bb39cc1411d378f"
            ],
            "turn_id": "mem-d01-t5"
          }

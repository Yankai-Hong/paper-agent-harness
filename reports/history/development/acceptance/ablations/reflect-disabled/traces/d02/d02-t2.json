                "paper_id": "2004.00809",
                "chunk_id": "c-227fd89576f8c0e3eb0ce352"
              }
            ]
          },
          {
            "key": "ground_truth_baselines",
            "text": "语料表示与四个真实基准比较：联合国国家级人口估计；按人均 GDP 和互联网使用统计调整的人口；联合国国家级普查语言汇总，缺失时用 World Factbook 估计。",
            "citations": [

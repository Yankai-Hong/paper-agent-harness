          "fewer_missing_languages": {
            "text": "在有些国家，语料库未覆盖人口实际使用的全部语言（普查中的语言未出现在数字文本中），这种缺失情况下 Twitter 缺失的语言更少。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570"
            ],
            "turn_id": "mem-d02-t6"
          },
          "fewer_false_positives_web": {
            "text": "整体上假阳性（语料库显示某语言频繁使用但普查未列出）很少，但 Twitter 数据的假阳性略多于网络抓取数据。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570"
            ],
            "turn_id": "mem-d02-t6"
          },
          "regional_difference": {
            "text": "两种语料库在欧洲、有基准数据的非洲部分地区及南美所预测的语言一致，但 Twitter 对北美和大洋洲的表示更好。",
            "evidence_ids": [
              "c-01b9a363a68a29a0e9af4ff8"
            ],
            "turn_id": "mem-d02-t6"
          },
          "common_languages_effect": {
            "text": "英语和西班牙语在 Twitter 上非常常见，因此以这两种语言为主的国家会默认得到良好表示，可能掩盖高真阳性率仅来自一两种语言的问题。",
            "evidence_ids": [
              "c-01b9a363a68a29a0e9af4ff8"
            ],
            "turn_id": "mem-d02-t6"
          },
          "false_positive_locations": {
            "text": "Twitter 的假阳性主要集中在俄罗斯和东欧，此外在美国、加拿大、南非、法国、印度和澳大利亚也存在过度预测的语言。",
            "evidence_ids": [
              "c-01b9a363a68a29a0e9af4ff8"
            ],
            "turn_id": "mem-d02-t6"
          },
          "collection_bias": {
            "text": "Twitter 数据通过 10k 城市 50km 半径的空间检索收集，未使用语言特定关键词，以避免选择偏差。",
            "evidence_ids": [
              "c-227fd89576f8c0e3eb0ce352"
            ],
            "turn_id": "mem-d02-t6"
          },
          "different_populations": {
            "text": "Twitter 与网络抓取数据所代表的人群显著不同：Twitter 在按 GDP 加权人口时匹配更好、按互联网使用统计加权时更差，暗示 Twitter 代表更富裕的人群，或与以城市为中心的收集方式有关。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570"
            ],
            "turn_id": "mem-d02-t6"
          },
          "correlation_values": {
            "text": "两种数据集与真实人口的相关性分别为 r=0.60（社交媒体）和 r=0.49（网络抓取）。",
            "evidence_ids": [
              "c-204aa49abd2af324ac170d44"
            ],
            "turn_id": "mem-d02-t6"
          },
          "not_addressed_causal": {
            "text": "提供的原文未解释 Twitter 为何比网络抓取更好地预测语言清单的具体因果机制，仅给出上述区域差异、缺失语言较少和假阳性分布等描述性发现。",
            "evidence_ids": [
              "c-204aa49abd2af324ac170d44",
              "c-9887004ca215701b79e8e570",
              "c-01b9a363a68a29a0e9af4ff8"
            ],
            "turn_id": "mem-d02-t6"
          },
          "not_addressed_urgency": {
            "text": "原文提到俄罗斯假阳性语言的来源（移民、旅游、商业）需要更多研究来区分，但提供的证据未给出针对该问题的进一步分析或定量结果。",
            "evidence_ids": [

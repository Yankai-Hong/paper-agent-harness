            ],
            "turn_id": "mem-d02-t7"
          },
          "few_false_positives": {
            "text": "总体而言，在给定地面真值语言数据的情况下，假阳性很少（语料显示某语言在某国频繁使用但普查不支持）；Twitter 数据的假阳性更多，但仍不常见。",
            "evidence_ids": [

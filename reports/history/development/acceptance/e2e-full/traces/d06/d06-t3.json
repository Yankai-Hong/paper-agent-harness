            "turn_id": "d06-t1"
          },
          "blog_identification": {
            "text": "Relevant blogs will be manually identified, and their authors will be contacted to obtain informed consent for using their texts.",
            "evidence_ids": [
              "c-b8ed06d1898387a8a4083045"
            ],
            "turn_id": "d06-t1"
          },
          "consent": {
            "text": "Implicit consent is assumed from users on these platforms to use their public tweets and posts.",
            "evidence_ids": [
              "c-b8ed06d1898387a8a4083045"
            ],
            "turn_id": "d06-t1"
          },
          "data_sources": {
            "text": "研究计划从三个来源收集与双相障碍（BD）总体及个人康复相关的数据：Twitter、Reddit（与以往工作不同，聚焦心理健康相关内容）以及由受影响个体撰写的博客。",
            "evidence_ids": [
              "c-b8ed06d1898387a8a4083045"
            ],
            "turn_id": "d06-t2"
          },
          "twitter_reddit_identification": {
            "text": "Twitter和Reddit上具有BD诊断的用户将通过自我报告的诊断陈述自动识别，例如“I was diagnosed with BD-I last week”。",
            "evidence_ids": [
              "c-b8ed06d1898387a8a4083045"
            ],
            "turn_id": "d06-t2"
          },
          "diagnosis_patterns_extension": {
            "text": "为实现上述识别，研究将在既有工作（BIBREF47）提供的BD诊断模式与术语基础上进行扩展。",
            "evidence_ids": [
              "c-b8ed06d1898387a8a4083045"
            ],
            "turn_id": "d06-t2"
          },
          "implicit_consent": {
            "text": "对于Twitter和Reddit平台上的用户，假定其公共推文和帖子存在隐式同意（implicit consent）。",
            "evidence_ids": [
              "c-b8ed06d1898387a8a4083045"
            ],
            "turn_id": "d06-t2"
          },
          "blog_identification_consent": {
            "text": "相关博客将被人工识别，并联系其作者以获得使用其文本的知情同意（informed consent）。",
            "evidence_ids": [
              "c-b8ed06d1898387a8a4083045"
            ],
            "turn_id": "d06-t2"
          },
          "previous_datasets_limitation": {
            "text": "以往Twitter的BD数据集已无法用于后续研究；两个Reddit数据集中与心理健康相关的内容被有意移除，因此这些数据无法用于分析心理健康在网上的谈论方式。",
            "evidence_ids": [
              "c-b8ed06d1898387a8a4083045"
            ],
            "turn_id": "d06-t2"
          },
          "project_aim": {
            "text": "该跨学科项目将收集并分析被诊断为双相障碍个体的社交媒体数据，以考察其康复经历。",
            "evidence_ids": [
              "c-8501c609aafc1a9ab4878246"
            ],
            "turn_id": "d06-t2"
          },
          "bd_identification_social_media": {
            "text": "在双相障碍论文中，双相障碍个体并非通过临床诊断流程在文中被重新识别，而是被界定为“被诊断为双相障碍”的个体，其社交媒体数据（第一人称在线叙述）将被收集和分析。",
            "evidence_ids": [
              "c-8501c609aafc1a9ab4878246"
            ],
            "turn_id": "d06-t3"
          },
          "bd_identification_criteria_question": {
            "text": "该论文的研究问题之一是“符合双相障碍标准的个体如何在网上讨论个人康复”，即研究对象以是否符合BD标准来界定，但所给证据未说明具体采用何种筛选或识别程序。",
            "evidence_ids": [
              "c-36b5890f191631d456e020a1"
            ],
            "turn_id": "d06-t3"
          },
          "bd_settings_comparison": {
            "text": "该研究计划比较来自不同情境（结构化访谈与 informal 在线话语）以及不同背景的双相障碍个体的叙述，而非仅在结构化环境中收集数据。",
            "evidence_ids": [
              "c-86f9f7f681d7fac5268e9c9b"
            ],
            "turn_id": "d06-t3"
          },
          "bd_linguistic_features": {
            "text": "双相障碍论文中所述的计算语言学方法旨在处理互联网上多种语言、族群多样人群的第一人称在线叙述，但所给证据未列出其具体采用的语言学特征清单。",
            "evidence_ids": [
              "c-8501c609aafc1a9ab4878246"
            ],
            "turn_id": "d06-t3"
          },
          "readable_participants": {
            "text": "《A Readable Read》不涉及临床个体识别：其研究对象是瑞典第二语言（L2）教材中的文本（由教师和教材编写者撰写），目标是预测这些材料的语言复杂度而非评估学习者产出的文本。",
            "evidence_ids": [
              "c-eaa4f5b0a34eef1ffc8a4b09"
            ],
            "turn_id": "d06-t3"
          },
          "readable_labels": {
            "text": "该论文采用欧洲语言共同参考框架（CEFR）的熟练度等级作为分类目标，文档级覆盖A1–C2六级，句子级进行A1–C1的五类分类。",
            "evidence_ids": [
              "c-eaa4f5b0a34eef1ffc8a4b09"
            ],
            "turn_id": "d06-t3"
          },
          "readable_feature_families": {
            "text": "该论文的特征来自多个语言学维度，包括词频等词汇特征、长度类特征、语义特征和句法特征，并提到前人工作使用词性标注器和依存句法分析器以及Coh-Metrix式的认知动机特征。",
            "evidence_ids": [
              "c-002c247f705e15494a446b37",
              "c-cbb7f9f0d9a80a8b97da806b"
            ],
            "turn_id": "d06-t3"
          },
          "readable_lexical_dominance": {
            "text": "在文档级，仅使用词汇特征即可达到约0.8的F值，与完整特征集的0.81相近，说明词汇信息单独就能较好区分教材文本的CEFR等级；而在句子级，组合多种特征比仅用词汇特征提升约7%的准确率。",
            "evidence_ids": [
              "c-002c247f705e15494a446b37",
              "c-619fec3b6e7991135faaea3f"
            ],
            "turn_id": "d06-t3"
          },
          "readable_lix": {
            "text": "该论文指出传统瑞典可读性指标LIX（结合平均句长与超过六个字符的长词比例）不适合此任务，其准确率很低且将91.6%的实例判为B2级。",
            "evidence_ids": [
              "c-eaa4f5b0a34eef1ffc8a4b09",
              "c-002c247f705e15494a446b37"
            ],
            "turn_id": "d06-t3"
          },
          "comparability_task": {
            "text": "两篇论文的任务目标不同：一篇旨在分析双相障碍个体的在线个人康复叙述，另一篇旨在预测瑞典L2教材文本和句子的CEFR熟练度等级，因此就“如何识别个体”这一问题而言，后者不涉及个体识别。",
            "evidence_ids": [
              "c-8501c609aafc1a9ab4878246",
              "c-eaa4f5b0a34eef1ffc8a4b09"
            ],
            "turn_id": "d06-t3"
          },
          "comparability_evidence_limits": {
            "text": "就可比性而言，所给证据只详细描述了《A Readable Read》的特征类别与结果，而双相障碍论文的证据未提供具体语言学特征清单，因此仅凭所给证据无法对两者的特征集进行逐项对比。",
            "evidence_ids": [
              "c-8501c609aafc1a9ab4878246",
              "c-002c247f705e15494a446b37"
            ],
            "turn_id": "d06-t3"
          }
        },

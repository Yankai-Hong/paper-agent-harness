              "c-6a524ef8fe27746863a8c5f0"
            ],
            "turn_id": "d11-t3"
          },
          "uit_model_architecture": {
            "text": "在 UIT-ViIC 的实验中，编码器部分先用 CNN 提取图像特征，解码器部分使用 RNN-LSTM 将向量嵌入为目标句子。",
            "evidence_ids": [
              "c-6a524ef8fe27746863a8c5f0"
            ],
            "turn_id": "d11-t3"
          },
          "uit_performance": {
            "text": "UIT-ViIC 摘要及结论仅总体说明在深度神经网络模型上评估数据集并与其他数据集比较，英文集仅在 BLEU-1 上优于越南语集，越南语集在 BLEU-2 至 BLEU-4 尤其 CIDEr 上表现较好；所给证据未提供微调模型在该数据集上的具体数值性能。",
            "evidence_ids": [
              "c-df82acb31723d02ba4213f1a",
              "c-bbd4db15d6773cfa30848a4a"
            ],
            "turn_id": "d11-t3"
          },
          "seva_model_used": {
            "text": "SEVA 论文选择 BERT 进行概念识别，使用其预训练的 cased 语言模型，基于 pytorch transformers 和 hugging face 的 BertForTokenClassification 做多类分类，并进行完整微调。",
            "evidence_ids": [
              "c-35ae853dec5dd79f61ef4980"
            ],
            "turn_id": "d11-t3"
          },
          "seva_additional_model": {
            "text": "SEVA 还使用 spaCy 实现概念识别，并得到相似结果。",
            "evidence_ids": [
              "c-35ae853dec5dd79f61ef4980"
            ],
            "turn_id": "d11-t3"
          },
          "seva_performance": {
            "text": "SEVA 中微调后的 BERT 模型在概念识别任务上取得 F1 分数 0.89，训练与评估采用 80-20 数据划分。",
            "evidence_ids": [
              "c-35ae853dec5dd79f61ef4980"
            ],
            "turn_id": "d11-t3"
          },
          "not_comparable": {
            "text": "两篇论文的任务与数据集不同（SEVA 为系统工程概念识别的词级标注 token 分类，UIT-ViIC 为越南语图像描述数据集评估），模型与指标也不同（BERT 用 F1，图像描述模型用 BLEU/CIDEr），因此两者性能不具备可比性。证据分别描述各自设置，未提供跨论文可直接比较的基准。",
            "evidence_ids": [
              "c-7e9b5fdcd1b735fa2b7de65a",
              "c-35ae853dec5dd79f61ef4980",
              "c-6a524ef8fe27746863a8c5f0",
              "c-df82acb31723d02ba4213f1a"
            ],
            "turn_id": "d11-t3"
          }
        },

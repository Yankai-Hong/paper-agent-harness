  "messages": [
    {
      "role": "user",
      "content": "关于论文《An Interactive Machine Translation Framework for Modernizing Historical Documents》，What kind of data is used to train the model?",
      "turn_id": "f8d0f5929a57458da20ae65516c9c294"
    },
    {
      "role": "assistant",
      "content": {
        "claims": [
          {
            "key": "dutch_bible_corpus",
            "text": "训练数据之一是 Dutch Bible 语料库，该语料库包含 1637、1657、1888 和 2010 年的多个版本，其中 1637 年版被视为原始文档、1888 年版被视为现代荷兰语。",
            "citations": [
              {
                "paper_id": "1910.03355",
                "chunk_id": "c-2b39005de67979a14fc26cd7"
              }
            ]
          },
          {
            "key": "el_quijote_corpus",
            "text": "第二个语料库是 El Quijote，包含 17 世纪的西班牙语小说及其对应的 21 世纪版本。",
            "citations": [
              {
                "paper_id": "1910.03355",
                "chunk_id": "c-2b39005de67979a14fc26cd7"
              }
            ]
          },
          {
            "key": "el_conde_lucanor_test_only",
            "text": "El Conde Lucanor 数据集包含 14 世纪原作及对应的 21 世纪版本，但由于语料库规模小，仅被用作测试。",
            "citations": [
              {
                "paper_id": "1910.03355",
                "chunk_id": "c-2b39005de67979a14fc26cd7"
              }
            ]
          },
          {
            "key": "el_conde_uses_el_quijote_systems",
            "text": "由于找不到合适的训练语料库，作者使用为 El Quijote 构建的系统来现代化 El Conde Lucanor。",
            "citations": [
              {
                "paper_id": "1910.03355",
                "chunk_id": "c-2b39005de67979a14fc26cd7"
              }
            ]
          },
          {
            "key": "small_training_corpora",
            "text": "训练语料库规模较小，这被认为是 SMT 优于 NMT 的可能原因之一。",
            "citations": [
              {
                "paper_id": "1910.03355",
                "chunk_id": "c-98f92e50001a68c58a20c08e"
              }
            ]
          }
        ],

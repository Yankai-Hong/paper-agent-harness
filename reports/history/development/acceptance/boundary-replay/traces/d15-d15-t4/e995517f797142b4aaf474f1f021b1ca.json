      "output": {
        "session_id": "d15-d15-t4",
        "entities": {
          "paper": "Neural Machine Translation for Low Resource Languages using Bilingual Lexicon Induced from Comparable Corpora",
          "paper_id": "1806.09652",
          "paper_1": "Neural Machine Translation for Low Resource Languages using Bilingual Lexicon Induced from Comparable Corpora",
          "paper_1_id": "1806.09652",
          "paper_2": "Towards better decoding and language model integration in sequence to sequence models",
          "paper_2_id": "1612.02695"
        },
        "facts": {
          "nmt_framework": {
            "text": "论文使用 OpenNMT 的 TensorFlow 实现来训练神经机器翻译模型。",
            "evidence_ids": [
              "c-0377bffbf88cf9ead25b03ff"
            ],
            "turn_id": "5a04582c6beb42558663267b3e571957"
          },
          "nmt_architecture": {
            "text": "NMT 模型采用基于注意力机制的 transformer 架构。",
            "evidence_ids": [
              "c-0377bffbf88cf9ead25b03ff"
            ],
            "turn_id": "5a04582c6beb42558663267b3e571957"
          },
          "smt_comparison": {
            "text": "作为对比，论文还使用 Moses 训练了基于短语的 SMT 系统，使用 grow-diag-final-and 短语抽取启发式、词汇化重排序、Batch MIRA 调参以及 KenLM 的 5-gram Kneser-Ney 平滑语言模型。",
            "evidence_ids": [
              "c-0377bffbf88cf9ead25b03ff"
            ],
            "turn_id": "5a04582c6beb42558663267b3e571957"
          },
          "language_pairs": {
            "text": "实验覆盖的语言对为英语–印地语（en–hi）和英语–泰米尔语（en–ta）。",
            "evidence_ids": [
              "c-278ad02ec178a2aa94b5e9d0",
              "c-1ef4f6dc83e93c39e90f82dc"
            ],
            "turn_id": "5a04582c6beb42558663267b3e571957"
          },
          "extraction_model": {
            "text": "该论文使用端到端的 Siamese 双向循环神经网络，从维基百科的可比多语文章中生成平行句对。",
            "evidence_ids": [
              "c-1dd6dc3c2f7d9eb29dc26d9f"
            ],
            "turn_id": "f1d0d72d166f47439c34b06b6480714b"
          },
          "extraction_components": {
            "text": "该抽取方法只需一个平行语料库，使用以 GRU 作为激活函数的 Siamese BiRNN 编码器来抽取平行句对。",
            "evidence_ids": [
              "c-1ef4f6dc83e93c39e90f82dc"
            ],
            "turn_id": "f1d0d72d166f47439c34b06b6480714b"
          },
          "no_feature_engineering": {
            "text": "与需要文档结构专门元数据或大量手工特征的先前方法相比，该抽取的神经模型仅用一小组平行句对作为引导集进行端到端学习。",
            "evidence_ids": [
              "c-2de814ddcd37609de37a6670"
            ],
            "turn_id": "f1d0d72d166f47439c34b06b6480714b"
          },
          "no_preexisting_mt": {
            "text": "作者称其深度神经网络模型不需要特征工程，也不需要预先存在的翻译系统，并将其描述为同类中首个这样的模型。",
            "evidence_ids": [
              "c-713c262decd20b8f527dcc24"
            ],
            "turn_id": "f1d0d72d166f47439c34b06b6480714b"
          },
          "data_sparsity_motivation": {
            "text": "论文旨在通过利用互联网上日益增多的多语内容来丰富双语词典，从而解决低资源机器翻译系统的高未登录词率问题。",
            "evidence_ids": [
              "c-2de814ddcd37609de37a6670"
            ],
            "turn_id": "f1d0d72d166f47439c34b06b6480714b"
          },
          "evaluation_design": {
            "text": "论文提出了一种神经平行句抽取方法，并比较使用与不使用所抽取句对时机器翻译系统的 BLEU 分数，以验证该方法的有效性。",
            "evidence_ids": [
              "c-2de814ddcd37609de37a6670"
            ],
            "turn_id": "f1d0d72d166f47439c34b06b6480714b"
          },
          "mt_systems_and_langs": {
            "text": "使用所收集的数据集，在英语–印地语和英语–泰米尔语这两个低资源语言对上，NMT 与基于短语的 SMT 系统的 BLEU 分数均有所提升。",
            "evidence_ids": [
              "c-1dd6dc3c2f7d9eb29dc26d9f"
            ],
            "turn_id": "f1d0d72d166f47439c34b06b6480714b"
          },
          "bleu_gains": {
            "text": "因使用神经架构从可比语料中抽取的平行句对，en–ta 与 en–hi 的 BLEU 分数分别提升了 11.03% 和 14.7%。",
            "evidence_ids": [
              "c-1ef4f6dc83e93c39e90f82dc"
            ],
            "turn_id": "f1d0d72d166f47439c34b06b6480714b"
          },
          "comparable_corpora": {
            "text": "如维基百科之类的可比语料是主题对齐但非句子对齐的多语文档集合，可从中抽取平行句。",
            "evidence_ids": [
              "c-2de814ddcd37609de37a6670"
            ],
            "turn_id": "f1d0d72d166f47439c34b06b6480714b"
          },
          "1806_model_for_nmt": {
            "text": "在1806.09652中，NMT系统并非本文提出的核心模型；本文提出并使用一个端到端的Siamese双向RNN（Siamese BiRNN，使用GRU作为激活函数）从维基百科的可比多语文章中抽取平行句对，随后用这些数据提升NMT和短语式SMT（针对英语-印地语、英语-泰米尔语低资源对）的BLEU分数。",
            "evidence_ids": [
              "c-1dd6dc3c2f7d9eb29dc26d9f",
              "c-1ef4f6dc83e93c39e90f82dc"
            ],
            "turn_id": "e995517f797142b4aaf474f1f021b1ca"
          },
          "1806_nmt_shortcoming_addressed": {
            "text": "1806.09652把低资源机器翻译的主要问题描述为：神经与统计机器翻译都高度依赖大量数据，在低资源设置下表现差，并因训练数据不足而出现低准确率与低覆盖（高OOV率）；作者通过利用互联网上的多语内容（如维基百科可比语料）丰富双语词典、抽取平行句对来应对高OOV问题。",
            "evidence_ids": [
              "c-2de814ddcd37609de37a6670"
            ],
            "turn_id": "e995517f797142b4aaf474f1f021b1ca"
          },
          "1806_solution_method": {
            "text": "1806.09652提出的方案是：用仅需一个小规模平行句对引导集、可端到端学习的神经模型（不需要特征工程，也不需要预存翻译系统）从可比语料中抽取平行句对，并与传统多步分类流程形成对比。",
            "evidence_ids": [
              "c-2de814ddcd37609de37a6670",
              "c-713c262decd20b8f527dcc24"
            ],
            "turn_id": "e995517f797142b4aaf474f1f021b1ca"
          },
          "1806_results": {
            "text": "1806.09652报告称，使用神经网络从可比语料抽取的平行句对使en–ta和en–hi的BLEU分数分别提升11.03%和14.7%。",
            "evidence_ids": [
              "c-1ef4f6dc83e93c39e90f82dc"
            ],
            "turn_id": "e995517f797142b4aaf474f1f021b1ca"
          },
          "1612_model_used": {
            "text": "1612.02695分析的是一个基于注意力的seq2seq语音识别系统，该系统直接把录音转写为字符；seq2seq网络被分解为编码模块、解码（拼写）模块和注意力模块。",
            "evidence_ids": [
              "c-c1a01afddd733ef65ed6d199",
              "c-0b5bc372895d6d0706b56a8e"
            ],
            "turn_id": "e995517f797142b4aaf474f1f021b1ca"
          },
          "1612_shortcomings": {
            "text": "1612.02695指出seq2seq模型的两个缺陷：预测过度自信（overconfidence），以及在使用语言模型时倾向于产生不完整转写（partial transcripts）。",
            "evidence_ids": [
              "c-c1a01afddd733ef65ed6d199"
            ],
            "turn_id": "e995517f797142b4aaf474f1f021b1ca"
          },
          "1612_overconfidence_solution": {
            "text": "针对过度自信，1612.02695比较了默认设置与更尖锐/更平滑分布（温度调整）的解码策略，并约束只在EOS概率与最可能token概率处于窄范围内时才发出EOS；同时指出温度升高时beam search能找到更好解，但需防止截断转写。",
            "evidence_ids": [
              "c-10d1ebcc07738e41f14a4005"
            ],
            "turn_id": "e995517f797142b4aaf474f1f021b1ca"
          },
          "1612_partial_transcript_solutions": {
            "text": "针对不完整转写，1612.02695比较三种策略：不改beam search准则但限制EOS发射；扩展beam search准则以鼓励长转写；以及提出coverage项，统计累计注意力超过阈值的帧数，以防止在录音片段上循环。",
            "evidence_ids": [
              "c-753acdce1e13381d0f0064dc"
            ],
            "turn_id": "e995517f797142b4aaf474f1f021b1ca"
          },
          "comparability_model": {
            "text": "就“NMT使用什么模型”而言，两篇论文可比性有限：1612.02695使用的是基于注意力的seq2seq系统且面向语音识别（直接转写为字符），而非NMT系统；1806.09652讨论NMT但核心模型是用于从可比语料抽取平行句对的Siamese BiRNN，而非其NMT翻译模型本身的架构细节。",
            "evidence_ids": [
              "c-c1a01afddd733ef65ed6d199",
              "c-1dd6dc3c2f7d9eb29dc26d9f"
            ],
            "turn_id": "e995517f797142b4aaf474f1f021b1ca"
          },
          "comparability_shortcomings": {
            "text": "就“seq2seq缺陷的解决方案”而言，两篇论文可比性很低：1612.02695针对的是seq2seq解码层面的缺陷（过度自信、语言模型导致的不完整转写）并提出解码/beam search与coverage等方案；1806.09652针对的是低资源NMT的数据稀缺与高OOV问题，提出的方案是数据层面的平行句对抽取。",
            "evidence_ids": [
              "c-c1a01afddd733ef65ed6d199",
              "c-2de814ddcd37609de37a6670"
            ],
            "turn_id": "e995517f797142b4aaf474f1f021b1ca"
          }
        },

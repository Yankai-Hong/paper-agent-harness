              "c-ab37506cf0e270f6ab4a5722"
            ],
            "turn_id": "46629ed58c0c46268e2f91894e4bfda9"
          },
          "resources_used": {
            "text": "构建该多语种语义角色标注器时，结合了 CoNLL 2009 共享任务中一对语言的资源，训练时组合多个语言的训练数据。",
            "evidence_ids": [

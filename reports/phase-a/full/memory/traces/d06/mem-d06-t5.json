            "turn_id": "mem-d06-t3"
          },
          "answerable_focus": {
            "text": "该论文可回答的部分是：研究关注被诊断为双相障碍（BD）个体的个人康复（personal recovery），计划收集并分析其社交媒体数据，并且研究对象是满足BD标准（meeting criteria for BD）的个体在线讨论康复的情况。",
            "evidence_ids": [
              "c-8501c609aafc1a9ab4878246",
              "c-36b5890f191631d456e020a1"
            ],
            "turn_id": "mem-d06-t4"
          },
          "answerable_questions": {
            "text": "论文明确列出的研究问题是：(1) 满足BD标准的个体如何在网上讨论个人康复；(2) 关于个人康复及其促进或阻碍因素能获得哪些新见解。",
            "evidence_ids": [
              "c-36b5890f191631d456e020a1"
            ],
            "turn_id": "mem-d06-t4"
          },
          "answerable_method": {
            "text": "在方法上，论文提出通过迭代方式构建康复相关术语词典，人工检查部分数据，并用USAS等语义标注方法标注相关文本片段，再在完整语料上量化关键词或概念的出现情况。",
            "evidence_ids": [
              "c-929453c2fb42eba7d101da7e"
            ],
            "turn_id": "mem-d06-t4"
          },
          "answerable_multilingual": {
            "text": "论文计划分两部分进行：一部分分析西方人的英语数据，另一部分分析不同族裔个体的多语言数据；并指出USAS可标注八种语言的语义类别。",
            "evidence_ids": [
              "c-36b5890f191631d456e020a1",
              "c-929453c2fb42eba7d101da7e"
            ],
            "turn_id": "mem-d06-t4"
          },
          "answerable_rationale": {
            "text": "论文指出既往个人康复研究主要来自结构化访谈、焦点小组和标准化问卷，样本较小，且主要在英语国家和西方族裔中进行，因此提出用计算语言学分析在线第一人称叙述以补充证据。",
            "evidence_ids": [
              "c-8501c609aafc1a9ab4878246",
              "c-723bbcf8cd5b62547d29306a"
            ],
            "turn_id": "mem-d06-t4"
          },
          "not_answerable_identification": {
            "text": "关于“如何识别/判定双相障碍个体”的具体识别方法、诊断流程或分类模型性能，所提供的论文片段中没有给出可核对的细节；论文仅提到研究对象为“被诊断为BD”或“满足BD标准”的个体。",
            "evidence_ids": [
              "c-8501c609aafc1a9ab4878246",
              "c-36b5890f191631d456e020a1"
            ],
            "turn_id": "mem-d06-t4"
          },
          "not_answerable_results": {
            "text": "所提供的证据属于项目计划与研究问题描述，未包含已完成的识别实验结果、准确率或验证数据，因此无法从中回答识别个体的实际效果。",
            "evidence_ids": [
              "c-8501c609aafc1a9ab4878246",
              "c-929453c2fb42eba7d101da7e"
            ],
            "turn_id": "mem-d06-t4"
          },
          "not_answerable_population_detail": {
            "text": "论文提及双相谱系障碍的患病率估计及跨文化诊断差异，但所给片段未提供用于识别个体的具体人群筛选标准或数据来源清单。",
            "evidence_ids": [
              "c-9614a06357ad25d045f1fc34",
              "c-723bbcf8cd5b62547d29306a"
            ],
            "turn_id": "mem-d06-t4"
          },
          "answerable_research_questions": {
            "text": "原文提出的研究问题是：(1) 符合BD标准的个体如何在网上讨论个人康复；(2) 关于个人康复及其促进或阻碍因素能获得哪些新见解；研究分两部分进行，一部分考察西方人的英语数据，另一部分考察不同族裔个体的多语言数据。",
            "evidence_ids": [
              "c-36b5890f191631d456e020a1"
            ],
            "turn_id": "mem-d06-t5"
          },
          "answerable_data_source_and_scope": {
            "text": "论文说明该项目将收集并分析被诊断为双相障碍个体的社交媒体数据，以研究其康复经历；并指出计算方法可分析在线分享的第一人称叙述，这些叙述代表非结构化情境以及更异质、多语言的人群。",
            "evidence_ids": [
              "c-8501c609aafc1a9ab4878246"
            ],
            "turn_id": "mem-d06-t5"
          },
          "answerable_bd_characterization": {
            "text": "原文将BD描述为以反复发作的抑郁和兴奋（轻躁狂或躁狂）情绪为特征，并提到双相谱系障碍估计影响约2%的英国人口，且在11个其他欧洲、美洲和亚洲国家中比率为0.1%–4.4%。",
            "evidence_ids": [
              "c-9614a06357ad25d045f1fc34"
            ],
            "turn_id": "mem-d06-t5"
          },
          "answerable_recovery_concept": {
            "text": "个人康复被松散地定义为“即使因疾病受限，仍过一种令人满意、充满希望且有贡献的生活”，其常用CHIME模型的主要成分是Connectedness、Hope and optimism、Identity、Meaning and purpose和Empowerment。",
            "evidence_ids": [
              "c-9614a06357ad25d045f1fc34"
            ],
            "turn_id": "mem-d06-t5"
          },
          "answerable_existing_evidence_gap": {
            "text": "既有定性证据主要来自（半）结构化访谈和焦点小组，被批评参与者人数少；此前研究只在结构化情境中进行，且康复概念主要源自英语国家、以西方族裔研究者和参与者为主的研究。",
            "evidence_ids": [
              "c-723bbcf8cd5b62547d29306a"
            ],
            "turn_id": "mem-d06-t5"
          },
          "answerable_identification_method": {
            "text": "针对难以把数据缩小到与个人康复相关的部分，论文提出迭代方法：依据以往定性研究编制初步的康复相关词词典，人工检查一小部分数据（部分随机抽样、部分选为含康复相关词），据此扩展词典，并用USAS等语义标注方法自动标注相关文本段的语义概念，再将语义标注应用于整个语料库以检索提及相关概念的文本段，还可用分布语义方法查找与词典词共现的术语，并在全语料库中量化关键词或概念的出现。",
            "evidence_ids": [
              "c-929453c2fb42eba7d101da7e"
            ],
            "turn_id": "mem-d06-t5"
          },
          "answerable_multilingual_tagging": {
            "text": "原文指出USAS可标注八种语言的语义类别，这一点对项目的多语言方面至关重要。",
            "evidence_ids": [
              "c-929453c2fb42eba7d101da7e"
            ],
            "turn_id": "mem-d06-t5"
          },
          "unanswerable_clinical_diagnosis_procedure": {
            "text": "所给原文证据没有描述如何临床诊断双相障碍个体、采用何种诊断标准或量表，也没有给出识别BD个体的具体算法或操作流程。",
            "evidence_ids": [
              "c-9614a06357ad25d045f1fc34",
              "c-8501c609aafc1a9ab4878246"
            ],
            "turn_id": "mem-d06-t5"
          },
          "unanswerable_results_and_performance": {
            "text": "所给证据只呈现研究计划与方法，没有报告实际识别BD个体的结果、分类性能指标或验证数据。",
            "evidence_ids": [
              "c-929453c2fb42eba7d101da7e",
              "c-36b5890f191631d456e020a1"

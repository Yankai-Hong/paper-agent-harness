            "turn_id": "mem-d06-t4"
          },
          "answerable_multilingual": {
            "text": "论文计划分两部分进行：一部分分析西方人的英语数据，另一部分分析不同族裔个体的多语言数据；并指出USAS可标注八种语言的语义类别。",
            "evidence_ids": [
              "c-36b5890f191631d456e020a1",
              "c-929453c2fb42eba7d101da7e"
            ],
            "turn_id": "mem-d06-t4"
          },
          "answerable_rationale": {
            "text": "论文指出既往个人康复研究主要来自结构化访谈、焦点小组和标准化问卷，样本较小，且主要在英语国家和西方族裔中进行，因此提出用计算语言学分析在线第一人称叙述以补充证据。",
            "evidence_ids": [
              "c-8501c609aafc1a9ab4878246",
              "c-723bbcf8cd5b62547d29306a"
            ],
            "turn_id": "mem-d06-t4"
          },
          "not_answerable_identification": {
            "text": "关于“如何识别/判定双相障碍个体”的具体识别方法、诊断流程或分类模型性能，所提供的论文片段中没有给出可核对的细节；论文仅提到研究对象为“被诊断为BD”或“满足BD标准”的个体。",
            "evidence_ids": [
              "c-8501c609aafc1a9ab4878246",
              "c-36b5890f191631d456e020a1"
            ],
            "turn_id": "mem-d06-t4"
          },
          "not_answerable_results": {
            "text": "所提供的证据属于项目计划与研究问题描述，未包含已完成的识别实验结果、准确率或验证数据，因此无法从中回答识别个体的实际效果。",
            "evidence_ids": [
              "c-8501c609aafc1a9ab4878246",
              "c-929453c2fb42eba7d101da7e"
            ],
            "turn_id": "mem-d06-t4"
          },
          "not_answerable_population_detail": {
            "text": "论文提及双相谱系障碍的患病率估计及跨文化诊断差异，但所给片段未提供用于识别个体的具体人群筛选标准或数据来源清单。",
            "evidence_ids": [
              "c-9614a06357ad25d045f1fc34",
              "c-723bbcf8cd5b62547d29306a"
            ],
            "turn_id": "mem-d06-t4"
          },
          "answerable_data_source_and_scope": {
            "text": "论文说明该项目将收集并分析被诊断为双相障碍个体的社交媒体数据，以研究其康复经历；并指出计算方法可分析在线分享的第一人称叙述，这些叙述代表非结构化情境以及更异质、多语言的人群。",
            "evidence_ids": [
              "c-8501c609aafc1a9ab4878246"
            ],
            "turn_id": "mem-d06-t5"
          },
          "answerable_bd_characterization": {
            "text": "原文将BD描述为以反复发作的抑郁和兴奋（轻躁狂或躁狂）情绪为特征，并提到双相谱系障碍估计影响约2%的英国人口，且在11个其他欧洲、美洲和亚洲国家中比率为0.1%–4.4%。",
            "evidence_ids": [
              "c-9614a06357ad25d045f1fc34"
            ],
            "turn_id": "mem-d06-t5"
          },
          "answerable_recovery_concept": {
            "text": "个人康复被松散地定义为“即使因疾病受限，仍过一种令人满意、充满希望且有贡献的生活”，其常用CHIME模型的主要成分是Connectedness、Hope and optimism、Identity、Meaning and purpose和Empowerment。",
            "evidence_ids": [
              "c-9614a06357ad25d045f1fc34"
            ],
            "turn_id": "mem-d06-t5"
          },
          "answerable_existing_evidence_gap": {
            "text": "既有定性证据主要来自（半）结构化访谈和焦点小组，被批评参与者人数少；此前研究只在结构化情境中进行，且康复概念主要源自英语国家、以西方族裔研究者和参与者为主的研究。",
            "evidence_ids": [
              "c-723bbcf8cd5b62547d29306a"
            ],
            "turn_id": "mem-d06-t5"
          },
          "answerable_identification_method": {
            "text": "针对难以把数据缩小到与个人康复相关的部分，论文提出迭代方法：依据以往定性研究编制初步的康复相关词词典，人工检查一小部分数据（部分随机抽样、部分选为含康复相关词），据此扩展词典，并用USAS等语义标注方法自动标注相关文本段的语义概念，再将语义标注应用于整个语料库以检索提及相关概念的文本段，还可用分布语义方法查找与词典词共现的术语，并在全语料库中量化关键词或概念的出现。",
            "evidence_ids": [
              "c-929453c2fb42eba7d101da7e"
            ],
            "turn_id": "mem-d06-t5"
          },
          "answerable_multilingual_tagging": {
            "text": "原文指出USAS可标注八种语言的语义类别，这一点对项目的多语言方面至关重要。",
            "evidence_ids": [
              "c-929453c2fb42eba7d101da7e"
            ],
            "turn_id": "mem-d06-t5"
          },
          "unanswerable_clinical_diagnosis_procedure": {
            "text": "所给原文证据没有描述如何临床诊断双相障碍个体、采用何种诊断标准或量表，也没有给出识别BD个体的具体算法或操作流程。",
            "evidence_ids": [
              "c-9614a06357ad25d045f1fc34",
              "c-8501c609aafc1a9ab4878246"
            ],
            "turn_id": "mem-d06-t5"
          },
          "unanswerable_results_and_performance": {
            "text": "所给证据只呈现研究计划与方法，没有报告实际识别BD个体的结果、分类性能指标或验证数据。",
            "evidence_ids": [
              "c-929453c2fb42eba7d101da7e",
              "c-36b5890f191631d456e020a1"
            ],
            "turn_id": "mem-d06-t5"
          },
          "unanswerable_dataset_details": {
            "text": "所给证据未说明具体使用哪些社交媒体平台的数据量、采样时间范围、纳入排除标准或伦理审查细节。",
            "evidence_ids": [
              "c-8501c609aafc1a9ab4878246",
              "c-929453c2fb42eba7d101da7e"
            ],
            "turn_id": "mem-d06-t5"
          },
          "answerable_population_focus": {
            "text": "论文可回答的部分包括：研究对象是被诊断为双相障碍（BD）的个体，研究目标是了解社交媒体帖子在多大程度上可以补充传统临床心理学研究方法，以获得关于BD诊断个体康复体验的洞见。",
            "evidence_ids": [
              "c-3dad4313e46ab93de51ac823"
            ],
            "turn_id": "mem-d06-t6"
          },
          "answerable_research_questions": {
            "text": "论文提出了两个研究问题：(1) 符合BD标准的个体如何在网上讨论个人康复；(2) 关于个人康复及其促进或阻碍因素，我们能获得什么新见解；研究分两部分进行，先看西方人的英语数据，再看不同族裔个体的多语言数据。",
            "evidence_ids": [
              "c-36b5890f191631d456e020a1"
            ],
            "turn_id": "mem-d06-t6"
          },
          "answerable_data_source_plan": {
            "text": "论文的数据来源计划是收集和分析西方人的英语数据，随后处理族裔多样的英语人群，最后处理多语言叙述；方法是混合方法，先从全数据集的统计分析开始，再对较少样本进行人工调查。",
            "evidence_ids": [
              "c-3dad4313e46ab93de51ac823"
            ],
            "turn_id": "mem-d06-t6"
          },
          "answerable_prior_sample_limitation": {
            "text": "论文指出，既往个人康复研究的科学基础存在不足，包括实验室收集数据的样本量小；而计算机辅助分析公共社交媒体数据可以克服这些小样本问题，并纳入更多样化的人群。",
            "evidence_ids": [
              "c-36b5890f191631d456e020a1"
            ],
            "turn_id": "mem-d06-t6"
          },
          "answerable_analytic_approach": {
            "text": "论文计划采用探索性定量研究，使用Wmatrix等比较分析工具，发现相对于参考语料库而言在收集数据集中出现频率异常的词语和关键概念等语言特征。",
            "evidence_ids": [
              "c-2ebc42588b00e156efec0ad4"
            ],
            "turn_id": "mem-d06-t6"
          },
          "unanswerable_specific_sample_size": {
            "text": "论文原文证据中没有给出该研究具体的样本量数值，只说明将克服既往实验室数据样本量小的问题。",
            "evidence_ids": [
              "c-36b5890f191631d456e020a1"
            ],
            "turn_id": "mem-d06-t6"
          },
          "unanswerable_diagnostic_criteria": {
            "text": "论文提到“符合BD标准（meeting criteria for BD）”和“BD诊断”，但提供的证据中没有列出具体采用的诊断标准或临床评估工具。",
            "evidence_ids": [
              "c-36b5890f191631d456e020a1",
              "c-3dad4313e46ab93de51ac823"
            ],
            "turn_id": "mem-d06-t6"
          },
          "unanswerable_classification_performance": {
            "text": "论文中不能回答分类性能相关问题：所给证据未报告任何识别分类器的构建、评估指标或性能结果，研究方法是探索性语言特征比较分析而非分类建模。",
            "evidence_ids": [
              "c-2ebc42588b00e156efec0ad4"
            ],
            "turn_id": "mem-d06-t6"
          },
          "unanswerable_identification_method": {
            "text": "论文中没有描述如何从社交媒体用户中具体识别出符合BD标准的个体或验证其诊断的方法；证据仅说明要分析社交媒体帖子，未提供识别流程细节。",
            "evidence_ids": [
              "c-3dad4313e46ab93de51ac823"
            ],
            "turn_id": "mem-d06-t6"
          },
          "unanswerable_ethics_consent": {
            "text": "论文提供的证据没有涉及伦理审批或知情同意细节；仅在致谢中提及感谢有BD生活经验的顾问小组提供反馈，这不等于伦理同意说明。",
            "evidence_ids": [
              "c-093462231b041b5c26738790"
            ],
            "turn_id": "mem-d06-t6"
          }

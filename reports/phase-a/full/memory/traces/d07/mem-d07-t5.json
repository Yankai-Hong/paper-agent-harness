            "turn_id": "mem-d07-t4"
          },
          "semantic_features": {
            "text": "语义特征基于瑞典语词汇语义资源 SALDO，包括每个 token 的平均义项数以及每个名词的平均名词义项数。",
            "evidence_ids": [

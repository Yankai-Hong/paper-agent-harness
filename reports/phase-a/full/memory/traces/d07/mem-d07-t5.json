            "turn_id": "mem-d07-t4"
          },
          "morphological_features": {
            "text": "形态特征包括各类词类的变异比与发生率、标点/小品词/从属和并列连词的发生率、中性名词的发生率、不同动词形式与所有动词的比率、双对数和平方根 TTR、名词比率、代词与介词的比率、两种词汇密度特征以及关系结构（关系副词、限定词、代词和所有格）。",
            "evidence_ids": [

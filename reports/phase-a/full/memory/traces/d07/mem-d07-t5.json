            ],
            "turn_id": "mem-d07-t2"
          },
          "task_focus": {
            "text": "该论文的目标是构建模型，用于预测面向第二语言（L2）学习者的瑞典语教材中文本和句子的熟练度等级。",
            "evidence_ids": [
              "c-cbb7f9f0d9a80a8b97da806b"
            ],
            "turn_id": "mem-d07-t3"
          },
          "feature_sources": {
            "text": "论文指出以往可读性模型使用的语言学特征包含来自词性标注器和依存句法分析器的信息；该论文基于一系列语言学特征构建监督学习模型。",
            "evidence_ids": [
              "c-cbb7f9f0d9a80a8b97da806b",
              "c-619fec3b6e7991135faaea3f"
            ],
            "turn_id": "mem-d07-t3"
          },
          "doc_level_perf": {
            "text": "文档层面模型取得了81.3%的准确率和0.8的F值。",
            "evidence_ids": [
              "c-619fec3b6e7991135faaea3f"
            ],
            "turn_id": "mem-d07-t3"
          },
          "sent_level_perf": {
            "text": "句子层面五分类模型的准确率为63.4%，相邻准确率达到92%。",
            "evidence_ids": [
              "c-619fec3b6e7991135faaea3f"
            ],
            "turn_id": "mem-d07-t3"
          },
          "feature_combo_sentence": {
            "text": "在句子层面，组合不同特征相比仅使用词汇特征使分类准确率提升了7%。",
            "evidence_ids": [
              "c-619fec3b6e7991135faaea3f"
            ],
            "turn_id": "mem-d07-t3"
          },
          "feature_combo_document": {
            "text": "在文档层面，词汇特征（仅使用词频特征）更具主导性，其预测效果几乎与全部特征组合相当。",
            "evidence_ids": [
              "c-619fec3b6e7991135faaea3f",
              "c-f16421f0ee652e6ad37ac288"
            ],
            "turn_id": "mem-d07-t3"
          },
          "lix_baseline": {
            "text": "传统瑞典语可读性指标LIX（结合平均句长与超过六个字符的长词比例）被认为不适合该任务；相比LIX，文档模型在准确率和F值上分别高出46%和0.6。",
            "evidence_ids": [
              "c-eaa4f5b0a34eef1ffc8a4b09",
              "c-f16421f0ee652e6ad37ac288"
            ],
            "turn_id": "mem-d07-t3"
          },
          "sentence_vs_lix": {
            "text": "句子层面模型在使用完整特征集时，分别比多数类基线和LIX高出23%和22%。",
            "evidence_ids": [
              "c-f16421f0ee652e6ad37ac288"
            ],
            "turn_id": "mem-d07-t3"
          },
          "dataset": {
            "text": "数据集取自COCTAILL语料库，覆盖A1至C1五个CEFR等级，共收集867篇阅读文本，并排除了以对话为主的文本。",
            "evidence_ids": [
              "c-61d8664ed913d55af106c226"
            ],
            "turn_id": "mem-d07-t3"
          },
          "not_answerable_specific_feature_inventory": {
            "text": "现有证据未给出完整的“语言学特征清单”逐项明细（例如每个具体特征名称及其单独的分类性能），仅提供了特征类别层面的概括。",
            "evidence_ids": [
              "c-619fec3b6e7991135faaea3f",
              "c-f16421f0ee652e6ad37ac288"
            ],
            "turn_id": "mem-d07-t3"
          },
          "not_answerable_performance_drop_cause": {
            "text": "作者指出文档层面与句子层面之间的性能下降原因仍需更详细的调查，因此现有证据无法回答该性能下降的具体成因。",
            "evidence_ids": [
              "c-f16421f0ee652e6ad37ac288"
            ],
            "turn_id": "mem-d07-t3"
          },
          "feature_source": {
            "text": "论文的特征基于先前文献和一本面向瑞典语L2学习者的语法书开发，特征集分为五个子组：长度、词汇、形态、句法和语义特征。",
            "evidence_ids": [
              "c-95d315be5888ab22f7efbd62"
            ],
            "turn_id": "mem-d07-t4"
          },
          "length_features": {
            "text": "长度特征包括句子长度（token 数和字符数）、超长词（超过13个字符）以及传统瑞典语可读性公式 LIX。",
            "evidence_ids": [

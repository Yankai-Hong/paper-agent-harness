            "turn_id": "mem-d02-t2"
          },
          "twitter_better_north_america_oceania": {
            "text": "原文指出，在按国家预测语言清单方面，两个语料库在欧洲、有基准数据的部分非洲地区和南美洲的结果一致，但 Twitter 对北美洲和大洋洲的代表性更好。",
            "evidence_ids": [
              "c-01b9a363a68a29a0e9af4ff8"
            ],
            "turn_id": "mem-d02-t3"
          },
          "twitter_fewer_missing_languages": {
            "text": "原文的第三项重要发现是：给定可获得的基准语言使用数据，仍有一些国家中这些语料库未能覆盖本地人口产生的全部语言；在此情况下 Twitter 缺失的语言更少。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570"
            ],
            "turn_id": "mem-d02-t3"
          },
          "wealthy_population_hypothesis": {
            "text": "原文提出的一种解释是：Twitter 数据在人口数按 GDP 加权时匹配得更好、按互联网使用统计加权时匹配得更差，这意味着 Twitter 平台代表的是比一般网页爬取数据更富裕的人口。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570"
            ],
            "turn_id": "mem-d02-t3"
          },
          "urban_collection_hypothesis": {
            "text": "原文提出的另一种解释是：此处的 Twitter 采集基于城市地区，而城市地区往往有更富裕的人口。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570"
            ],
            "turn_id": "mem-d02-t3"
          },
          "english_spanish_default_hypothesis": {
            "text": "原文提到，英语和西班牙语在 Twitter 上都很常见（参见表 3），因此任何主要使用这两种语言的国家默认就会有较好的代表性；原文还指出，许多国家只有少数几种语言，某国的高真阳性率可能只反映一两种语言。",
            "evidence_ids": [
              "c-01b9a363a68a29a0e9af4ff8"
            ],
            "turn_id": "mem-d02-t3"
          },
          "locals_vs_nonlocals_question": {
            "text": "原文在讨论 Twitter 代表性时提出了本地居民与非本地用户的区分，并追问非洲国家在 Twitter 数据中过代表所反映的用户是当地人口成员还是访客。",
            "evidence_ids": [
              "c-1bf564989651e887cbd88011"
            ],
            "turn_id": "mem-d02-t3"
          },
          "can_answer_hypotheses_listed": {
            "text": "可以回答的部分：原文明确列出了对 Twitter 数据表现的若干解释性假设，包括富裕人口假设、城市地区采集假设、英语和西班牙语常见带来的默认代表性，以及本地与非本地用户的区分问题。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570",
              "c-01b9a363a68a29a0e9af4ff8",
              "c-1bf564989651e887cbd88011"
            ],
            "turn_id": "mem-d02-t3"
          },
          "cannot_answer_causal_testing": {
            "text": "不能回答的部分：原文没有报告对这些假设进行检验或因果识别的结果；对城市采集假设，原文只是反问以农村为中心的采集是否会出现同样偏差，并将其称为次要问题。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570"
            ],
            "turn_id": "mem-d02-t3"
          },
          "cannot_answer_relative_importance": {
            "text": "不能回答的部分：所给证据未说明富裕人口解释与城市采集解释之间哪个更重要或各自贡献多大。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570"
            ],
            "turn_id": "mem-d02-t3"
          },
          "cannot_answer_africa_user_identity": {
            "text": "不能回答的部分：原文提出非洲 Twitter 用户是本地居民还是访客的问题，但所给证据没有给出该问题的答案。",
            "evidence_ids": [
              "c-1bf564989651e887cbd88011"
            ],
            "turn_id": "mem-d02-t3"
          },
          "cannot_answer_false_positive_sources": {
            "text": "不能回答的部分：关于误报语言，原文说明需要更多研究来区分移民、旅游和商务等可能来源，表明所给证据无法在这些来源之间作出判定。",
            "evidence_ids": [
              "c-01b9a363a68a29a0e9af4ff8"
            ],
            "turn_id": "mem-d02-t3"
          },
          "answerable_finding_twitter_better_language_inventory": {
            "text": "论文摘要明确给出结论：Twitter 数据在预测每个国家所使用的语言清单方面表现更好（Twitter data makes better predictions about the inventory of languages used in each country）。",
            "evidence_ids": [
              "c-204aa49abd2af324ac170d44"
            ],
            "turn_id": "mem-d02-t4"
          },
          "answerable_mechanism_fewer_missing_languages": {
            "text": "讨论部分给出的解释性证据是：存在若干国家，语料未能覆盖本地人口产生的全部语言（并非所有人口普查中的语言都能在数字文本中找到），而在这种情况中 Twitter 缺失的语言更少。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570"
            ],
            "turn_id": "mem-d02-t4"
          },
          "answerable_mechanism_regional_representation": {
            "text": "在区域层面，两种语料在欧洲、有基准数据的部分非洲地区以及南美洲对语言的预测一致，而 Twitter 对北美和大洋洲提供了更好的表示。",
            "evidence_ids": [
              "c-01b9a363a68a29a0e9af4ff8"
            ],
            "turn_id": "mem-d02-t4"
          },
          "answerable_caveat_english_spanish_defaults": {
            "text": "原文提醒：许多国家语言数量很少，一个国家较高的真阳性率可能只反映一两种语言；由于英语和西班牙语在 Twitter 上非常常见，任何主要使用这两种语言的国家会默认得到较好的表示。",
            "evidence_ids": [
              "c-01b9a363a68a29a0e9af4ff8"
            ],
            "turn_id": "mem-d02-t4"
          },
          "answerable_twitter_more_false_positives": {
            "text": "讨论部分指出：总体上假阳性很少，但 Twitter 数据中的假阳性更多；原文并说明 Twitter 在美国、加拿大、南非、法国、印度和澳大利亚存在过度预测的语言。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570",
              "c-01b9a363a68a29a0e9af4ff8"
            ],
            "turn_id": "mem-d02-t4"
          },
          "answerable_sampling_avoids_language_bias": {
            "text": "Twitter 语料采用空间检索，收集 1 万座城市 50 公里半径内的推文，且不使用特定语言关键词或话题标签，以避免选择偏差。",
            "evidence_ids": [
              "c-227fd89576f8c0e3eb0ce352"
            ],
            "turn_id": "mem-d02-t4"
          },
          "answerable_wealth_and_urban_confound": {
            "text": "原文给出的解释性假设是：Twitter 数据在按 GDP 加权人口时匹配更好、按互联网使用统计加权时更差，这意味着 Twitter 平台代表的是比一般网页抓取数据更富裕的人群；另一种解释是本研究的 Twitter 收集基于城市地区，而城市人口往往更富裕。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570"
            ],
            "turn_id": "mem-d02-t4"
          },
          "answerable_georeference_confound": {
            "text": "原文承认 Twitter 数据集依赖地理定位推文，但并非所有用户都有 GPS 设备，并推测人均 GDP 较低的国家地理定位推文比例可能更低、推文总量也更少。",
            "evidence_ids": [
              "c-227fd89576f8c0e3eb0ce352"
            ],
            "turn_id": "mem-d02-t4"
          },
          "answerable_purpose_is_baseline_not_correction": {
            "text": "原文说明其目的不是判定语料表示在特定地点是否偏斜或不准确，而是测量这些数据集在何处、以何种方式偏斜，作为评估和改进未来数据收集方法的基线；这也说明偏斜本身不被视为需在此阶段解决的问题。",
            "evidence_ids": [
              "c-9112346152089bf519490033"
            ],
            "turn_id": "mem-d02-t4"
          },
          "not_answerable_rural_collection_test": {
            "text": "原文提出“以农村为中心的收集程序是否也会发现同样的偏差”这一开放问题，并将其称为次要问题，未给出检验结果；因此现有证据不能回答城乡收集方式对语言清单预测差异的影响。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570"
            ],
            "turn_id": "mem-d02-t4"
          },
          "not_answerable_false_positive_sources": {
            "text": "原文指出需要更多研究来区分移民、旅游和商业作为数字数据集中假阳性语言出现的替代来源；因此现有证据不能回答这些假阳性的具体成因。",
            "evidence_ids": [
              "c-01b9a363a68a29a0e9af4ff8"
            ],
            "turn_id": "mem-d02-t4"
          },
          "not_answerable_causal_mechanism": {
            "text": "证据仅支持相关与描述性解释（如缺失语言更少、区域表示差异、财富/城市偏差假设），原文未建立 Twitter 特性与国家语言清单预测更优之间的因果机制，故该因果问题不能据此回答。",
            "evidence_ids": [
              "c-204aa49abd2af324ac170d44",
              "c-9887004ca215701b79e8e570"

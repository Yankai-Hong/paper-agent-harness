              "c-2e6195119fdfce8fe43dc752"
            ],
            "turn_id": "4868d544640d46eba0fca1db9751c51a"
          },
          "subtask_performance_limits": {
            "text": "作者称其语言模型在配对比较中表现更好，但明确表示仍需更多研究来改进半排序结果，并认为深度学习可能克服Ngram语言模型的一些局限。",
            "evidence_ids": [
              "c-2e6195119fdfce8fe43dc752"
            ],
            "turn_id": "4868d544640d46eba0fca1db9751c51a"
          },
          "oov_limitation": {
            "text": "语言模型方法的一个局限是遇到大量词汇表外词，且该问题无法通过增加训练数据量解决，因为幽默依赖语言的创造性使用，例如基于自造词的谐音笑话。",
            "evidence_ids": [
              "c-fe0545dbe9418ac897a44fc9"
            ],
            "turn_id": "4868d544640d46eba0fca1db9751c51a"
          },
          "dl_motivation": {
            "text": "作者认为深度学习技术可能在处理未知词、文本中的长距离依赖以及词与概念之间的非线性关系方面带来改进；字符级CNN不依赖训练数据中出现过的词元，而LSTM等RNN可捕捉Ngram模型无法做到的长距离依赖。",
            "evidence_ids": [
              "c-fe0545dbe9418ac897a44fc9"
            ],
            "turn_id": "4868d544640d46eba0fca1db9751c51a"
          },
          "external_knowledge": {
            "text": "论文引用他人发现称，检测基于推文的幽默需要外部知识，如书名、电影名、歌词、名人传记等，因为某些笑话依赖时事和流行文化。",
            "evidence_ids": [
              "c-fe0545dbe9418ac897a44fc9"

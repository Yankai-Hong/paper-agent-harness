              "c-9887004ca215701b79e8e570"
            ],
            "turn_id": "mem-d02-t6"
          },
          "unanswered_false_positive_sources": {
            "text": "原文指出需要更多研究来区分移民、旅游和商业作为数字数据集中假阳性语言出现的替代来源。",
            "evidence_ids": [
              "c-01b9a363a68a29a0e9af4ff8"
            ],
            "turn_id": "mem-d02-t6"
          },
          "unanswered_rural_bias": {
            "text": "原文将“以农村为中心的收集程序是否会出现同样的偏差”列为次要问题；现有证据未直接回答该问题。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570"
            ],
            "turn_id": "mem-d02-t6"
          },
          "not_population_ranking_focus": {
            "text": "论文的目标是测量这些数据集在何处、以何种方式被偏斜，作为评估和改进未来数据收集方法的手段，而非在此时判断语料库表示在特定地点是否偏斜或不准确。",
            "evidence_ids": [
              "c-9112346152089bf519490033"
            ],
            "turn_id": "mem-d02-t6"
          },
          "answerable_core_conclusion": {
            "text": "摘要明确指出：Twitter 数据能对国家所用语言清单做出更好的预测（“Twitter data makes better predictions about the inventory of languages used in each country”）。",
            "evidence_ids": [
              "c-204aa49abd2af324ac170d44"
            ],
            "turn_id": "mem-d02-t7"
          },
          "answerable_mechanism_missing_languages": {
            "text": "讨论部分给出支持该结论的机制性证据：在存在基准语言使用数据的国家中，有些国家数字文本未覆盖人口使用的全部语言，即普查中的部分语言在数字文本中缺失；而在这种情况下，Twitter 所缺失的语言更少。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570"
            ],
            "turn_id": "mem-d02-t7"
          },
          "answerable_regional_pattern": {
            "text": "原文指出，在预测各国所用语言方面，两个语料库在欧洲、有基准数据的非洲部分地区以及南美洲大体一致，但 Twitter 对北美和大洋洲的代表性更好。",
            "evidence_ids": [
              "c-01b9a363a68a29a0e9af4ff8"
            ],
            "turn_id": "mem-d02-t7"
          },
          "not_answerable_no_per_country_metrics": {
            "text": "所给证据没有提供按国家逐一比较 Twitter 与网络抓取数据在语言清单预测上的具体指标（如各国准确率、召回率或 F 值），因此无法回答“哪些具体国家上 Twitter 更优、优多少”。",
            "evidence_ids": [
              "c-01b9a363a68a29a0e9af4ff8"
            ],
            "turn_id": "mem-d02-t7"
          },
          "not_answerable_false_positive_caveat": {
            "text": "该结论并非无条件成立：讨论部分指出 Twitter 数据的假阳性（语料显示某语言在某国常用但普查未显示）虽然不多，但比网络抓取数据更多；因此不能把“Twitter 预测更优”理解为在所有指标上都更优。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570"
            ],
            "turn_id": "mem-d02-t7"
          },
          "not_answerable_ground_truth_limits": {
            "text": "证据无法回答 Twitter 优势是否在所有国家都成立，因为原文限定该比较以“现有基准语言使用数据”为前提，并指出并非所有普查语言都出现在数字文本中。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570"
            ],
            "turn_id": "mem-d02-t7"
          },
          "not_answerable_collection_confound": {
            "text": "证据表明 Twitter 语料依赖地理定位推文，而并非所有用户都有支持 GPS 的设备；原文推测人均 GDP 较低的国家地理定位推文比例可能更低，但未量化该偏差对国家语言清单预测优势的影响。",
            "evidence_ids": [
              "c-227fd89576f8c0e3eb0ce352"
            ],
            "turn_id": "mem-d02-t7"
          },
          "supported_overall_claim": {
            "text": "摘要明确指出，Twitter 数据对各国使用的语言清单做出的预测更好。",
            "evidence_ids": [
              "c-204aa49abd2af324ac170d44"
            ],
            "turn_id": "mem-d02-t8"
          },
          "supported_population_correlation": {
            "text": "摘要报告，两个数据集与实际人口的相关性：社交媒体为 r=0.60，网络抓取数据为 r=0.49，并表示这两个数据集代表的是非常不同的人群。",
            "evidence_ids": [
              "c-204aa49abd2af324ac170d44"
            ],
            "turn_id": "mem-d02-t8"
          },
          "supported_fewer_missing_languages": {
            "text": "讨论部分指出，在一些国家，这些语料并未呈现出当地人口使用的所有语言；在这种情况下，Twitter 缺失的语言更少。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570"
            ],
            "turn_id": "mem-d02-t8"
          },
          "supported_more_false_positives_twitter": {
            "text": "讨论部分指出，错误正例（语料显示某语言在该国被频繁使用，但普查数据并未显示）总体上很少，不过在 Twitter 数据中错误正例更多。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570"
            ],
            "turn_id": "mem-d02-t8"
          },
          "supported_regional_pattern": {
            "text": "在两种语料预测一致的国家中（欧洲、有基准数据的非洲部分地区、南美洲），Twitter 对北美和大洋洲的代表性更好。",
            "evidence_ids": [
              "c-01b9a363a68a29a0e9af4ff8"
            ],
            "turn_id": "mem-d02-t8"
          },
          "supported_twitter_false_positive_regions": {
            "text": "Twitter 的错误正例大多出现在俄罗斯和东欧，此外在美国和加拿大、南非、法国、印度和澳大利亚也存在过度预测的语言。",
            "evidence_ids": [
              "c-01b9a363a68a29a0e9af4ff8"
            ],
            "turn_id": "mem-d02-t8"
          },
          "supported_caveat_few_languages": {
            "text": "论文提示，许多国家只有少数几种语言，因此某国的高真阳性率可能只反映了一两种语言；英语和西班牙语在 Twitter 上非常常见，因此以这两种语言为主的国家默认就会有较好的代表性。",
            "evidence_ids": [
              "c-01b9a363a68a29a0e9af4ff8"
            ],
            "turn_id": "mem-d02-t8"
          },
          "unanswered_ground_truth_coverage": {
            "text": "无法确定的是：在有基准语言使用数据缺失或不足的国家（如普查数据不可得、只能依赖 World Factbook 估计的地区），Twitter 与网络抓取数据在语言清单预测上的比较结果如何。",
            "evidence_ids": [
              "c-9112346152089bf519490033"
            ],
            "turn_id": "mem-d02-t8"
          },
          "unanswered_causal_reasons": {
            "text": "无法从所给证据确定 Twitter 错误正例的成因。论文表示需要更多研究来区分移民、旅游和商业等不同来源。",
            "evidence_ids": [
              "c-01b9a363a68a29a0e9af4ff8"
            ],
            "turn_id": "mem-d02-t8"
          },
          "unanswered_sampling_bias": {
            "text": "无法确定：如果改用农村为中心的采集程序，是否会得到同样的偏倚。原文只是提出这个作为开放问题。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570"
            ],
            "turn_id": "mem-d02-t8"
          },
          "unanswered_confounds": {
            "text": "无法量化 Twitter 数据的混杂因素（例如并非所有用户都有支持 GPS 的设备、人均 GDP 较低的国家地理定位推文比例可能更低），也无法确定它对语言清单预测比较的具体影响；原文只说明这些因素可能造成偏倚。",
            "evidence_ids": [
              "c-227fd89576f8c0e3eb0ce352"
            ],
            "turn_id": "mem-d02-t8"
          }
        },

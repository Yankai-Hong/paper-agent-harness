            ],
            "turn_id": "mem-d02-t8"
          },
          "supported_fewer_missing_languages": {
            "text": "讨论部分指出，在一些国家，这些语料并未呈现出当地人口使用的所有语言；在这种情况下，Twitter 缺失的语言更少。",
            "evidence_ids": [

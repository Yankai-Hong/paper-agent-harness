            "turn_id": "mem-d02-t7"
          },
          "supported_population_correlation": {
            "text": "摘要报告，两个数据集与实际人口的相关性：社交媒体为 r=0.60，网络抓取数据为 r=0.49，并表示这两个数据集代表的是非常不同的人群。",
            "evidence_ids": [

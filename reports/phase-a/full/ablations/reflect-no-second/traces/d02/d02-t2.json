            "turn_id": "d02-t1"
          },
          "twitter_false_positives_regions": {
            "text": "The authors report that on Twitter most false positives are in Russia and Eastern Europe, with over-predicted languages also in the US and Canada, South Africa, France, India, and Australia.",

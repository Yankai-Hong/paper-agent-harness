            ],
            "turn_id": "d02-t1"
          },
          "twitter_represents_wealthier_populations": {
            "text": "The authors imply that Twitter as a platform represents more wealthy populations than general web-crawled data, based on Twitter matching populations better when weighted by GDP and worse when weighted by internet-usage statistics.",

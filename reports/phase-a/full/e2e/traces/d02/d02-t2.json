            ],
            "turn_id": "d02-t1"
          },
          "twitter_better_coverage_regions": {
            "text": "In many cases the two corpora agree on which languages they predict to be used per country (Europe, parts of Africa with ground-truth, and South America), but Twitter provides a better representation of North America and Oceania.",
            "evidence_ids": [
              "c-01b9a363a68a29a0e9af4ff8"
            ],
            "turn_id": "d02-t1"
          },
          "english_spanish_common_twitter": {
            "text": "The authors note that English and Spanish are very common on Twitter, so any country predominantly using these two languages will have a good representation by default.",

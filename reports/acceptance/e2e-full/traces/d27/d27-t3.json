            "turn_id": "d27-t2"
          },
          "c1_data_source_paper1": {
            "text": "在《F-Score Driven Max Margin Neural Network for Named Entity Recognition in Chinese Social Media》中，数据来自中国的新浪微博（Sina Weibo）服务。",
            "evidence_ids": [
              "c-014d25fff447b24d4e5aae00"
            ],
            "turn_id": "d27-t3"
          },
          "c2_data_source_paper2": {
            "text": "在《Who's to say what's funny? A computer using Language Models and Deep Learning, That's Who!》中，数据是由推特（tweets）构成，这些幽默推文是为喜剧中心（Comedy Central）电视节目 @midnight with Chris Hardwick 期间提供的 hashtag 提示而提交的。",
            "evidence_ids": [
              "c-04fd36e8ebf0badf98e5c22f",
              "c-42b2a8b4190d48e2271bf4e7"
            ],
            "turn_id": "d27-t3"
          },
          "c3_platform_comparability": {
            "text": "两篇论文的数据来源平台不同：前者使用新浪微博（中国社交媒体），后者使用推特（tweet）数据；证据中未说明二者的具体可比程度。",
            "evidence_ids": [
              "c-014d25fff447b24d4e5aae00",
              "c-04fd36e8ebf0badf98e5c22f"
            ],
            "turn_id": "d27-t3"
          },
          "c4_lm_prediction_ngram": {
            "text": "在《Who's to say what's funny?...》中，系统使用传统 N-gram 语言模型估计推文概率，用 bigram 和 trigram 作为特征，并使用带修改的 Kneser-Ney 平滑和回退技术的 KenLM 工具。",
            "evidence_ids": [
              "c-42b2a8b4190d48e2271bf4e7"
            ],
            "turn_id": "d27-t3"
          },
          "c5_lm_prediction_corpora": {
            "text": "该论文从两个不同语料库建立语言模型：一个来自 @midnight 节目的搞笑推文集合，另一个是免费供研究使用的新闻数据语料库。",
            "evidence_ids": [
              "c-42b2a8b4190d48e2271bf4e7"
            ],
            "turn_id": "d27-t3"
          },
          "c6_lm_prediction_scoring": {
            "text": "推文的评分方式为：根据搞笑推文模型概率更高者被认为更好笑（因为更像幽默训练数据），而根据新闻语言模型概率更低者被认为更好笑（因为最不像不搞笑的新闻语料）。",
            "evidence_ids": [
              "c-42b2a8b4190d48e2271bf4e7"
            ],
            "turn_id": "d27-t3"
          },
          "c7_lm_ranking": {
            "text": "该论文使用语言模型和深度学习方法，使潜在幽默的陈述可以相对彼此进行排序（ranking），而非仅做二分类。",
            "evidence_ids": [
              "c-04fd36e8ebf0badf98e5c22f",
              "c-ab1f50c84fac89c654f4ed96"
            ],
            "turn_id": "d27-t3"
          },
          "c8_lm_deeplearning_outline": {
            "text": "该论文报告了使用语言模型方法的结果，并概述了未来使用深度学习方法的计划，而非已用深度学习模型做幽默预测。",
            "evidence_ids": [
              "c-ab1f50c84fac89c654f4ed96"
            ],
            "turn_id": "d27-t3"
          },
          "c9_ner_model_paper1": {
            "text": "在《F-Score Driven Max Margin...》中，提出的模型是基于 B-LSTM 神经网络的半监督学习模型，并把 CRF 等传统方法中的转移概率与深度学习结合。",
            "evidence_ids": [

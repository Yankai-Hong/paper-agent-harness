            ],
            "turn_id": "d27-t3"
          },
          "c10_ner_usage_paper1": {
            "text": "该论文的模型用于中文社交媒体命名实体识别（NER），构造了可直接在 F-score 上训练的模型，并提出在 F-score 和标签准确率上联合训练的集成方法。",
            "evidence_ids": [
              "c-9a8e2c5a1623ba6a00cddbb9"

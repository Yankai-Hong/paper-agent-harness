            ],
            "turn_id": "d07-t2"
          },
          "word_frequency_vs_all": {
            "text": "Using only word-frequency features was almost as predictive as a combination of all features for the document level, but the combination made more accurate predictions for sentences, resulting in a 7% difference in accuracy.",

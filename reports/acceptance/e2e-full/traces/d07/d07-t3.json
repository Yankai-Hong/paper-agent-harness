              "c-619fec3b6e7991135faaea3f"
            ],
            "turn_id": "d07-t2"
          },
          "basis_features": {
            "text": "The supervised machine learning model is based on a range of linguistic features and the paper first shows that the traditional Swedish readability measure LIX is not suitable for this task.",
            "evidence_ids": [
              "c-619fec3b6e7991135faaea3f"
            ],
            "turn_id": "d07-t2"
          },
          "feature_sources": {
            "text": "The linguistic features explored for readability tasks incorporate information, among others, from part-of-speech (POS) taggers and dependency parsers, and cognitively motivated features have also been proposed, for example in Coh-Metrix.",
            "evidence_ids": [
              "c-cbb7f9f0d9a80a8b97da806b"
            ],
            "turn_id": "d07-t2"
          },
          "document_results": {
            "text": "The document-level model achieved an accuracy of 81.3% and an F-score of 0.8.",
            "evidence_ids": [
              "c-619fec3b6e7991135faaea3f"
            ],
            "turn_id": "d07-t2"
          },
          "sentence_results": {
            "text": "A separate model trained on sentence-level data with five classes yielded 63.4% accuracy, and an adjacent accuracy of 92% was achieved.",

              "c-619fec3b6e7991135faaea3f"
            ],
            "turn_id": "d07-t2"
          },
          "feature_combination_sentence": {
            "text": "Using a combination of different features, compared to using lexical features alone, resulted in a 7% improvement in classification accuracy at the sentence level.",

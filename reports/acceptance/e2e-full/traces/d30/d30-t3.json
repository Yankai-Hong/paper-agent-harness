              "c-188a871a6da3d11b36702382"
            ],
            "turn_id": "d30-t2"
          },
          "aligned_corpus_goal": {
            "text": "论文的目标是构建并分析一个由讽刺标题与几乎相同但严肃的标题配对组成的语料库。",
            "evidence_ids": [
              "c-be0fea6bdea95279d0ba1400"
            ],
            "turn_id": "d30-t2"
          },
          "corpus_construction_method": {
            "text": "该配对语料库通过 Unfun.me 构建，这是一个在线游戏，激励玩家对讽刺标题做最小修改，使其他玩家相信修改结果是严肃标题。",
            "evidence_ids": [
              "c-be0fea6bdea95279d0ba1400"
            ],
            "turn_id": "d30-t2"
          },
          "onion_acceptance_rate": {
            "text": "即使在 The Onion，每周生成的 600 条标题中也只有 16 条（不到 3%）被接受。",
            "evidence_ids": [
              "c-5892e58ce4dcf31d0605c1ef"
            ],
            "turn_id": "d30-t2"
          },
          "reverse_direction_rationale": {
            "text": "论文主张反方向任务更容易：小的编辑即可去除讽刺标题中的幽默，使其看起来像可能发表在真实新闻媒体上的严肃标题。",
            "evidence_ids": [
              "c-5892e58ce4dcf31d0605c1ef"
            ],
            "turn_id": "d30-t2"
          },
          "onion_running_example": {
            "text": "论文给出的例子是将 The Onion 的讽刺标题中的“God”改为“Bob Dylan”，从而得到可能逐字出现在严肃报纸上的标题。",
            "evidence_ids": [
              "c-08a90544401173f481c068d2"
            ],
            "turn_id": "d30-t2"
          },
          "headline_similarity_observation": {
            "text": "论文指出，讽刺标题与严肃新闻标题不仅在风格上相似，在内容上也相似：改动单个词常常就足以让讽刺标题听起来像严肃新闻。",
            "evidence_ids": [
              "c-08a90544401173f481c068d2"
            ],
            "turn_id": "d30-t2"
          },
          "analysis_findings": {
            "text": "论文分析发现，幽默倾向位于标题末尾并主要存在于名词短语中，且多数讽刺标题遵循一种被称为“假类比”的逻辑模式。",
            "evidence_ids": [
              "c-be0fea6bdea95279d0ba1400"
            ],
            "turn_id": "d30-t2"
          },
          "onion_1901_dataset": {
            "text": "1901.03253 使用 The Onion 作为其讽刺语料库：其讽刺性标题语料由 The Onion 发布的 9,159 条标题组成，严肃语料则由 9 个主要新闻网站的 9,000 条标题组成。",
            "evidence_ids": [
              "c-188a871a6da3d11b36702382"
            ],
            "turn_id": "d30-t3"
          },
          "onion_1901_counts": {
            "text": "1901.03253 在句法分析中说明，它对其 The Onion 语料库中全部 9,159 条原始标题进行了分块处理。",
            "evidence_ids": [
              "c-279178dcc9e082109b5cb49c"
            ],
            "turn_id": "d30-t3"
          },
          "onion_1809_no": {
            "text": "所提供证据未表明 1809.02208 使用 The Onion 作为数据集；其材料被描述为来自美国劳工统计局（BLS）的职业列表、COCA 中的 21 个形容词，以及使用 Google Translate API 翻译的构造句。",
            "evidence_ids": [
              "c-c49993752c0b10ccfb6bdc75"
            ],
            "turn_id": "d30-t3"
          },
          "demo_1809_yes": {
            "text": "1809.02208 考察了美国女性劳动者的真实分布：它使用美国劳工统计局关于女性在各职业类别中参与比例的统计数据（并针对每个单独职业的数据），与翻译后女性代词频率的 12 分位直方图并排比较。",
            "evidence_ids": [
              "c-6d84e20bfa1a0d5f93e73fb6"
            ],
            "turn_id": "d30-t3"
          },
          "demo_1809_conclusion": {
            "text": "1809.02208 报告称，女性劳动者分布与女性翻译频率之间没有相关性，并指出 Google Translate 的输出未能反映女性劳动者的真实分布，低估了预期频率。",
            "evidence_ids": [
              "c-1c78b22c818d4036c6510107"
            ],
            "turn_id": "d30-t3"
          },
          "demo_1809_assumption": {
            "text": "1809.02208 明确说明一个假设：若男性默认值频率高估了某一职业中男性与女性员工的分布，则 Google Translate 存在负面性别偏见，即其基准是以职业人口统计为参照来判定的。",
            "evidence_ids": [
              "c-bf50e77dea8722dc9d0a44b4"
            ],
            "turn_id": "d30-t3"
          },
          "demo_1901_no": {
            "text": "所提供证据未表明 1901.03253 考察任何国家女性劳动者的真实分布；其方法侧重于来自 The Onion 和新闻网站的讽刺与严肃新闻标题，用于收集对齐的标题对。",
            "evidence_ids": [
              "c-188a871a6da3d11b36702382",
              "c-1227dab8f28deccf5101507c"
            ],
            "turn_id": "d30-t3"
          },
          "comparability": {
            "text": "就这两个问题而言，两篇论文不可直接比较：所提供证据显示 1901.03253 明确使用 The Onion，而 1809.02208 使用 BLS 职业数据与翻译统计进行对比，且未使用 The Onion；同时 1809.02208 考察美国女性劳动者的真实职业分布，而 1901.03253 的证据未表明考察任何此类人口统计分布。",
            "evidence_ids": [
              "c-188a871a6da3d11b36702382",
              "c-c49993752c0b10ccfb6bdc75",
              "c-6d84e20bfa1a0d5f93e73fb6",
              "c-1227dab8f28deccf5101507c"
            ],
            "turn_id": "d30-t3"
          }
        },

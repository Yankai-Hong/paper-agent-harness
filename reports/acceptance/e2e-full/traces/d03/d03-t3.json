          "fever_model_accuracy": {
            "text": "《Unsupervised Question Answering for Fact-Checking》的方法在转换后数据集的开发集上取得 80.2% 的标签准确率，在测试集上取得 80.25% 的标签准确率。",
            "evidence_ids": [
              "c-7c69a28e7ffcb9ebd09842b6"
            ],
            "turn_id": "d03-t3"
          },
          "fever_compare_hexaf": {
            "text": "该论文将“SUPPORTS”标签的标签准确率与监督方法 HexaF 进行比较，并称当 φ = 0.76 时其方法可与 HexaF 相媲美。",
            "evidence_ids": [
              "c-41beb2396050f5a800883bfc"
            ],
            "turn_id": "d03-t3"
          },
          "fever_no_explicit_gain": {
            "text": "所提供的证据仅说明其结果与 HexaF 可比，并未给出相对该基线的明确数值提升幅度。",
            "evidence_ids": [
              "c-41beb2396050f5a800883bfc"
            ],
            "turn_id": "d03-t3"
          },
          "clinical_outperforms": {
            "text": "《Clinical Information Extraction via Convolutional Neural Network》报告称，其初始提交 RUN 4 和 RUN 5 在事件表达任务上于每项任务的每个指标上都优于记忆基线，并称其方法在标准评估数据集上持续优于现有基线方法。",
            "evidence_ids": [
              "c-a0309b4d3fb3a7dc29b07966",
              "c-f45dc29ea469cc573133e3c9"
            ],
            "turn_id": "d03-t3"
          },
          "clinical_no_numeric_gain": {
            "text": "所提供的证据未给出该临床模型相对基线在性能上的具体数值提升幅度。",
            "evidence_ids": [
              "c-a0309b4d3fb3a7dc29b07966"
            ],
            "turn_id": "d03-t3"
          },
          "not_comparable_tasks": {
            "text": "两篇论文回答的是不同任务：前者是事实核查，将 FEVER 转换为 Cloze 任务，并统计“SUPPORTS”标签的准确率；后者是从临床记录中抽取事件跨度及属性，因此两者的性能提升数字不具备可比性。",
            "evidence_ids": [
              "c-7c69a28e7ffcb9ebd09842b6",
              "c-712a82e231bc15b7c11610b4"
            ],
            "turn_id": "d03-t3"
          },
          "not_comparable_datasets": {
            "text": "两篇论文的数据集不同，分别为 FEVER 的 Wikipedia 主张与 Mayo Clinic 的临床记录和病理报告，故 FEVER 规模相关结论也不适用于临床论文。",

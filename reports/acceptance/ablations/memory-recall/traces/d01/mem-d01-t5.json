          "can_answer_temporal_scope": {
            "text": "论文实验分析的是截至2018年8月（实验进行时）Google Translate的“快照”。",
            "evidence_ids": [
              "c-a16ba09a7bc25650191fb8b9"
            ],
            "turn_id": "mem-d01-t3"
          },
          "cannot_answer_cross_country_distribution": {
            "text": "所提供的证据仅说明使用美国BLS职业数据中的女性参与百分比作为对照，未说明考察了“性别中立语言使用国家/地区”女性工作者的真实世界分布；因此该问题中按国家/地区划分的真实分布部分不能由现有证据回答。",
            "evidence_ids": [
              "c-0ff7525d7bb39cc1411d378f",
              "c-d56cdc01d43cd2975b96cb5f"
            ],
            "turn_id": "mem-d01-t3"
          },
          "bias_definition_vs_demographics": {
            "text": "论文明确假设：若男性默认频率高估了某职业中男性雇员相对女性雇员（可能不平等）的分布，则谷歌翻译存在负面性别偏见。",
            "evidence_ids": [
              "c-bf50e77dea8722dc9d0a44b4"
            ],
            "turn_id": "mem-d01-t4"
          },
          "male_defaults_beyond_demographics": {
            "text": "作者提供实验证据表明，即使不预期50:50的代词性别分布，谷歌翻译产生男性默认的频率也远高于仅由人口统计数据所能预期的水平。",
            "evidence_ids": [
              "c-0ff7525d7bb39cc1411d378f"
            ],
            "turn_id": "mem-d01-t4"
          },
          "method_neutral_languages": {
            "text": "论文使用12种性别中立语言（如匈牙利语、中文、约鲁巴语等）构造如“He/She is an Engineer”的句子，经谷歌翻译API译为英语并统计代词性别频率。",
            "evidence_ids": [
              "c-0ff7525d7bb39cc1411d378f"
            ],
            "turn_id": "mem-d01-t4"
          },
          "stereotype_examples": {
            "text": "论文举例说明，涉及刻板性别角色的句子被高概率地按刻板印象翻译：nurse和baker译为女性代词，engineer和CEO译为男性代词。",
            "evidence_ids": [
              "c-10f671efdbe25a3af88930ca"
            ],
            "turn_id": "mem-d01-t4"
          },
          "cannot_answer_country_breakdown": {
            "text": "所提供证据仅说明使用BLS（美国）数据对照女性参与频率，未提供按“性别中立语言使用国家”分别考察女性工作者真实分布的内容，因此无法从现有证据判断作者是否考察了这些国家内部的女性工作者分布。",
            "evidence_ids": [
              "c-0ff7525d7bb39cc1411d378f"
            ],
            "turn_id": "mem-d01-t4"
          },
          "cannot_answer_beyond_google": {
            "text": "论文讨论部分提到该偏见是独立于任何专有工具的统计现象，但所给证据未说明作者考察了除谷歌翻译之外的、特定国家女性劳动者的真实世界分布数据。",
            "evidence_ids": [

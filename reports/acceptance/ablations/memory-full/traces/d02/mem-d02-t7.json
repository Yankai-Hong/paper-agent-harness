            "turn_id": "mem-d02-t6"
          },
          "twitter_better_north_america_oceania": {
            "text": "两种语料在欧洲、有真值数据的非洲部分地区以及南美对各国语言的预测一致，但 Twitter 对北美和大洋洲的表示更好。",
            "evidence_ids": [

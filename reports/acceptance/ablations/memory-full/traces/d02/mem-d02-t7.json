            "turn_id": "mem-d02-t6"
          },
          "fewer_missing_languages_twitter": {
            "text": "在基于真值语言使用数据的评估中，有些国家的语料未覆盖当地人口使用的全部语言，此时 Twitter 缺失的语言更少。",
            "evidence_ids": [

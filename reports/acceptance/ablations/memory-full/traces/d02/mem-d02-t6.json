            ],
            "turn_id": "mem-d02-t5"
          },
          "few_false_positives_but_more_on_twitter": {
            "text": "整体上假阳性很少，但 Twitter 数据中的假阳性更多，Twitter 上在美国、加拿大、南非、法国、印度和澳大利亚存在过度预测的语言。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570",
              "c-01b9a363a68a29a0e9af4ff8"
            ],
            "turn_id": "mem-d02-t5"
          },
          "twitter_gdp_weighting": {
            "text": "Twitter 数据在按 GDP 加权的人口数下匹配更好、按互联网使用统计加权时匹配更差，这暗示 Twitter 平台比一般网络爬取数据更能代表较富裕人群，也可能是采集以城市地区为基础所致。",
            "evidence_ids": [
              "c-9887004ca215701b79e8e570"
            ],
            "turn_id": "mem-d02-t5"
          },
          "answerable_method_and_metric": {
            "text": "可回答的方法与度量：论文以联合国（UN）汇总普查数据为真值，缺失时用 CIA World Factbook，并采用“某语言占该国语料观测至少 5% 即视为该国使用该语言”的阈值，用真阳性率与假阳性率比较语料与人口。",
            "evidence_ids": [

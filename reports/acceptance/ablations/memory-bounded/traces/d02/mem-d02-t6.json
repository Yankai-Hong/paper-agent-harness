            "turn_id": "mem-d02-t5"
          },
          "twitter_gdp_weighting": {
            "text": "当人口数按 GDP 加权时，Twitter 数据与人口匹配得更好；按互联网使用统计加权时则更差；论文将其解释为 Twitter 平台代表的是更富裕的人群，或与其基于城市区域的采集方式有关。",
            "evidence_ids": [

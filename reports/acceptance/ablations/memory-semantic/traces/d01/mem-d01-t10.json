          "bls_data_compared": {
            "text": "该研究以美国劳工统计局（BLS）的职业列表构建句子，并将 Google Translate 译出结果中的代词频率与 BLS 各类职业女性参与比例数据进行了对照。",
            "evidence_ids": [
              "c-0ff7525d7bb39cc1411d378f",
              "c-6d84e20bfa1a0d5f93e73fb6"
            ],
            "turn_id": "mem-d01-t9"
          },
          "twelve_gender_neutral_languages": {
            "text": "论文使用 12 种性别中立语言（如匈牙利语、汉语、约鲁巴语等）构造“He/She is an Engineer”这类句子并译为英语以统计代词性别分布。",
            "evidence_ids": [
              "c-0ff7525d7bb39cc1411d378f"
            ],
            "turn_id": "mem-d01-t9"
          },
          "male_default_tendency": {
            "text": "Google Translate 表现出强烈的男性默认倾向，尤其是在性别分布失衡的领域（如 STEM 职业）。",
            "evidence_ids": [
              "c-0ff7525d7bb39cc1411d378f"
            ],
            "turn_id": "mem-d01-t9"
          },
          "fails_to_match_real_distribution": {
            "text": "论文称 Google Translate 未能重现真实世界的女性劳动者分布；即使不预设 50:50 的代词性别分布，其男性默认出现频率也远高于仅由人口统计数据所预期的水平。",
            "evidence_ids": [
              "c-0ff7525d7bb39cc1411d378f"
            ],
            "turn_id": "mem-d01-t9"
          },
          "quantile_comparison": {
            "text": "论文对每 12 分位计算女性参与频率，并同样计算译文中女性代词频率，将两侧直方图并列比较；结果显示译文女性代词集中在第一个 12 分位，而 BLS 数据显示女性参与在第四个 12 分位达到峰值并在其后分位保持显著。",
            "evidence_ids": [
              "c-6d84e20bfa1a0d5f93e73fb6"
            ],
            "turn_id": "mem-d01-t9"
          },
          "male_dominated_definition": {
            "text": "论文引用美国劳工部妇女局的界定，将女性参与低于 25% 的领域视为男性主导领域，并借此讨论译文统计是否只是反映职业人口结构。",
            "evidence_ids": [
              "c-6d84e20bfa1a0d5f93e73fb6"
            ],
            "turn_id": "mem-d01-t9"
          },
          "time_snapshot": {
            "text": "论文说明其实验分析的是该工具截至 2018 年 8 月的“快照”，预印本于 2018 年 9 月 6 日发布在 arXiv.org。",
            "evidence_ids": [
              "c-a16ba09a7bc25650191fb8b9"
            ],
            "turn_id": "mem-d01-t9"
          },
          "december_2018_policy_change": {
            "text": "论文记载 2018 年 12 月 6 日 Google 政策改变，发布声明并推出同时给出女性与男性官方译文的新功能，称其属于促进公平、减少机器学习偏见的更大目标。",
            "evidence_ids": [
              "c-a16ba09a7bc25650191fb8b9"

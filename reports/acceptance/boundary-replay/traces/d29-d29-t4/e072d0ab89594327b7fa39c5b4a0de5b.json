          "paper": "Tackling Online Abuse: A Survey of Automated Abuse Detection Methods",
          "paper_id": "1908.06024"
        },
        "facts": {
          "feature_sets_nobata": {
            "text": "Nobata et al. evaluated a large range of features on the Yahoo! datasets using a regression model: (1) word and character n-grams; (2) linguistic features such as number of polite/hate words and punctuation count; (3) syntactic features such as parent and grandparent of a node in a dependency tree; (4) distributional-semantic features such as paragraph2vec comment representations.",
            "evidence_ids": [
              "c-891d7142a2d2cad4f16b6f9c"
            ],
            "turn_id": "d75625ebdcce42c89e405ab3eb6370ca"
          },
          "char_ngram_robustness": {
            "text": "Although the best results were achieved with all features combined, character n-grams on their own contributed significantly more than other features due to their robustness to noise (obfuscations, misspellings, unseen words).",
            "evidence_ids": [
              "c-891d7142a2d2cad4f16b6f9c"
            ],
            "turn_id": "d75625ebdcce42c89e405ab3eb6370ca"
          },
          "char_vs_word_superiority": {
            "text": "Mehdad and Tetreault's results demonstrated the superiority of character-level features over word-level ones, with SVM classifiers trained on Bayesian log-ratio vectors of average counts of character n-grams outperforming the approach of Nobata et al. in terms of AUC as well as other RNN-based character and word-level models.",
            "evidence_ids": [
              "c-891d7142a2d2cad4f16b6f9c"
            ],
            "turn_id": "d75625ebdcce42c89e405ab3eb6370ca"
          },
          "bow_features": {
            "text": "Bag-of-words (BOW) features have been integral to several works on abuse detection; for example, Sood et al. showed that an SVM trained on word bi-gram features outperformed a word-list baseline using a Levenshtein distance-based heuristic for detecting profanity.",
            "evidence_ids": [
              "c-892e55b6de4edd89afd5eff6"
            ],
            "turn_id": "d75625ebdcce42c89e405ab3eb6370ca"
          },
          "word_ngrams_other_features": {
            "text": "Word n-grams have been used in conjunction with other features, such as typed-dependency relations or scores based on sentiment lexicons, to train SVMs.",
            "evidence_ids": [
              "c-892e55b6de4edd89afd5eff6"
            ],
            "turn_id": "d75625ebdcce42c89e405ab3eb6370ca"
          },
          "tfidf_ngrams": {
            "text": "Salminen et al. showed that a linear SVM using tf-idf weighted n-grams achieves the best performance on classification of hateful comments as one of 29 different hate categories.",
            "evidence_ids": [
              "c-892e55b6de4edd89afd5eff6"
            ],
            "turn_id": "d75625ebdcce42c89e405ab3eb6370ca"
          },
          "hand_engineered_features": {
            "text": "Samghabadi et al. augmented features with hand-engineered ones such as polarity scores derived from SentiWordNet, measures based on the LIWC program, and features based on emoticons; distributional-semantic features combined with these constituted an effective feature space.",
            "evidence_ids": [
              "c-f45f8ae3b81df25a89e5319c"
            ],
            "turn_id": "d75625ebdcce42c89e405ab3eb6370ca"
          },
          "char_ngrams_general": {
            "text": "In line with the findings of Nobata et al. and Mehdad and Tetreault, character n-grams performed well on the datasets used by Samghabadi et al.",
            "evidence_ids": [
              "c-f45f8ae3b81df25a89e5319c"
            ],
            "turn_id": "d75625ebdcce42c89e405ab3eb6370ca"
          },
          "germeval_winning": {
            "text": "The winning system of the GermEval shared task employed multiple character and token n-gram classifiers, as well as distributional semantic features obtained by averaging word embeddings.",
            "evidence_ids": [
              "c-2f212f20ecf57a84c49074df"
            ],
            "turn_id": "d75625ebdcce42c89e405ab3eb6370ca"
          },
          "hindi_lexical": {
            "text": "The top approach for Hindi in the aggression identification shared task utilized lexical features based on word and character n-grams.",
            "evidence_ids": [
              "c-2f212f20ecf57a84c49074df"
            ],
            "turn_id": "d75625ebdcce42c89e405ab3eb6370ca"
          },
          "sarcasm_surface_insufficient": {
            "text": "Sarcastic comments are hard for abuse detection methods to deal with since surface features are not sufficient; typically knowledge of the context or background of the user is also required.",
            "evidence_ids": [
              "c-482db66d96fa77c449b5baed"
            ],
            "turn_id": "d75625ebdcce42c89e405ab3eb6370ca"
          },
          "metaphor_frequency": {
            "text": "Mishra found that metaphors are more frequent in abusive samples as opposed to non-abusive ones.",

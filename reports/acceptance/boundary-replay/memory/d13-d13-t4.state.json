    {
      "role": "user",
      "content": "请检索以下问题的相关原文：关于论文《Polyglot Semantic Role Labeling》，what resources are combined to build the labeler?",
      "turn_id": "46629ed58c0c46268e2f91894e4bfda9"
    },
    {
      "role": "assistant",
      "content": {
        "claims": [
          {
            "key": "combined_resources",
            "text": "The polyglot semantic role labeler is built by combining resources from a pair of languages in the CoNLL 2009 shared task.",
            "citations": [
              {
                "paper_id": "1805.11598",
                "chunk_id": "c-8b21bd8c4c41f76753d2758d"
              }
            ]
          },
          {
            "key": "no_parallel_data",
            "text": "The approach is applied notwithstanding the absence of parallel data and the dissimilarity in annotations between languages.",
            "citations": [
              {
                "paper_id": "1805.11598",
                "chunk_id": "c-8b21bd8c4c41f76753d2758d"
              }
            ]
          },
          {
            "key": "parsers_variants",
            "text": "The authors train several parsers for each language in the CoNLL 2009 dataset: a traditional monolingual version and variants that additionally incorporate supervision from the English portion of the dataset.",
            "citations": [
              {
                "paper_id": "1805.11598",
                "chunk_id": "c-ab37506cf0e270f6ab4a5722"
              }
            ]
          },
          {
            "key": "dataset_languages",
            "text": "The CoNLL 2009 dataset includes seven different languages, whose semantic label spaces are entirely language-specific.",
            "citations": [
              {
                "paper_id": "1805.11598",
                "chunk_id": "c-ab37506cf0e270f6ab4a5722"
              }
            ]
          },
          {
            "key": "polyglot_training_basis",
            "text": "The polyglot training approach trains one model on multiple languages, sharing statistical strength across languages through parameter sharing rather than explicit annotation alignment.",
            "citations": [
              {
                "paper_id": "1805.11598",
                "chunk_id": "c-ab37506cf0e270f6ab4a5722"
              }
            ]
          },
          {
            "key": "evaluation_languages",
            "text": "The system is evaluated on the SRL portion of CoNLL-2009 for Catalan, Chinese, Czech, English, German, Japanese and Spanish.",
            "citations": [
              {
                "paper_id": "1805.11598",
                "chunk_id": "c-d2d99eebfd526f64d0796b70"
              }
            ]
          }
        ],
        "decision": "answer"
      },
      "turn_id": "46629ed58c0c46268e2f91894e4bfda9"
    },
